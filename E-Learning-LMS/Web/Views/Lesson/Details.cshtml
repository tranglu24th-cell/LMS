@model Web.Models.EF.Lesson

@{
    ViewData["Title"] = Model.Title;
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @Model.Title - E-Learning
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f7fb;
            color: #1e293b;
        }

        /* ================= TOPBAR ================= */

        .topbar {
            height: 70px;
            background: white;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            padding: 0 25px;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #2563eb;
            text-decoration: none;
            margin-right: 40px;
        }

        .top-link {
            text-decoration: none;
            color: #334155;
            margin-right: 30px;
            font-size: 15px;
        }

            .top-link:hover {
                color: #2563eb;
            }

        /* ================= LAYOUT ================= */

        .layout {
            display: flex;
            min-height: calc(100vh - 70px);
        }

        /* ================= SIDEBAR ================= */

        .sidebar {
            width: 320px;
            background: white;
            border-right: 1px solid #dbe1ea;
            padding: 20px;
            overflow-y: auto;
        }

        .sidebar-title {
            font-size: 14px;
            font-weight: bold;
            color: #475569;
            margin-bottom: 15px;
        }

        .sidebar-section {
            border: 1px solid #dbe1ea;
            border-radius: 8px;
            margin-bottom: 15px;
            overflow: hidden;
        }

        .sidebar-header {
            background: #dbe8ff;
            padding: 14px;
            font-weight: bold;
            color: #334155;
        }

        .sidebar-item {
            display: block;
            padding: 10px 15px;
            text-decoration: none;
            color: #475569;
            font-size: 14px;
        }

            .sidebar-item:hover {
                background: #f1f5f9;
                color: #2563eb;
            }

            .sidebar-item.active {
                background: #eef4ff;
                color: #2563eb;
                font-weight: bold;
            }

        /* ================= MAIN ================= */

        .main {
            flex: 1;
            padding: 45px;
            max-width: 1400px;
            margin: auto;
        }

        /* ================= BREADCRUMB ================= */

        .breadcrumb-box {
            margin-bottom: 25px;
        }

            .breadcrumb-box a {
                color: #2563eb;
                text-decoration: none;
            }

        /* ================= LESSON ================= */

        .lesson-container {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 35px;
        }

        .lesson-label {
            display: inline-block;
            background: #eef4ff;
            color: #2563eb;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            margin-bottom: 15px;
        }

        .lesson-title {
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .lesson-meta {
            color: #64748b;
            margin-bottom: 30px;
        }

        .lesson-content {
            font-size: 16px;
            line-height: 1.8;
            white-space: pre-line;
        }

            .lesson-content img {
                max-width: 100%;
                height: auto;
            }

        /* ================= BUTTON ================= */

        .navigation {
            display: flex;
            justify-content: space-between;
            margin-top: 40px;
            padding-top: 25px;
            border-top: 1px solid #e5e7eb;
        }

        .btn-back {
            background: #f1f5f9;
            color: #334155;
            padding: 10px 18px;
            border-radius: 6px;
            text-decoration: none;
        }

            .btn-back:hover {
                background: #e2e8f0;
            }

        /* ================= MOBILE ================= */

        @@media (max-width: 900px) {

            .sidebar {
                display: none;
            }

            .main {
                padding: 20px;
            }

            .lesson-container {
                padding: 25px;
            }

            .lesson-title {
                font-size: 25px;
            }
        }

        .sidebar-chapter {
            border-bottom: 1px solid #e5e7eb;
        }

        .sidebar-chapter-title {
            padding: 12px 15px;
            background: #e8f0ff;
            color: #1e40af;
            font-weight: bold;
            font-size: 14px;
        }

        .sidebar-chapter .sidebar-item {
            padding-left: 25px;
        }

    </style>

</head>


<body>

    <!-- ================= TOPBAR ================= -->

    <div class="topbar">

        <a href="/"
           class="logo">
            E-Learning
        </a>

        <a href="/Course"
           class="top-link">
            Chuyên mục
        </a>

        <a asp-controller="Learning"
           asp-action="MyCourses"
           class="top-link">
            Khóa học của tôi
        </a>

        <a asp-controller="Learning"
           asp-action="Results"
           class="top-link">
            Kết quả học tập
        </a>

    </div>


    <!-- ================= LAYOUT ================= -->

    <div class="layout">


        <!-- ================= SIDEBAR ================= -->

        <aside class="sidebar">

            <div class="sidebar-section">

                <div class="sidebar-header">
                    @Model.Course?.Title
                </div>

                @if (Model.Course?.Lessons != null &&
                Model.Course.Lessons.Any())
                {
                    var chapters = Model.Course.Lessons
                    .OrderBy(x => x.ChapterOrder)
                    .ThenBy(x => x.OrderNumber)
                    .GroupBy(x => new
                    {
                        x.ChapterOrder,
                        x.ChapterName
                    });

                    foreach (var chapter in chapters)
                    {
                        <div class="sidebar-chapter">

                            <div class="sidebar-chapter-title">
                                <span>
                                    @(string.IsNullOrWhiteSpace(chapter.Key.ChapterName)
                                        ? $"Chương {chapter.Key.ChapterOrder}"
                                        : chapter.Key.ChapterName)
                                </span>
                            </div>

                            @foreach (var lesson in chapter)
                            {
                                <a href="/Lesson/Details/@lesson.Id"
                                   class="sidebar-item @(lesson.Id == Model.Id ? "active" : "")">

                                    <span>
                                        @lesson.OrderNumber. @lesson.Title
                                    </span>

                                </a>
                            }

                        </div>
                    }
                }
                else
                {
                    <div class="sidebar-item">
                        Chưa có bài học
                    </div>
                }

            </div>

        </aside>


        <!-- ================= MAIN ================= -->

        <main class="main">


            <!-- ================= BREADCRUMB ================= -->

            <div class="breadcrumb-box">

                <a href="/Course/Details/@Model.CourseId">
                    @Model.Course?.Title
                </a>

                <span>
                    /
                </span>

                <span>
                    @Model.Title
                </span>

            </div>


            <!-- ================= LESSON CONTENT ================= -->

            <div class="lesson-container">

                <span class="lesson-label">
                    Bài học
                </span>


                <h1 class="lesson-title">
                    @Model.OrderNumber.
                    @Model.Title
                </h1>


                <div class="lesson-meta">

                    <strong>
                        Khóa học:
                    </strong>

                    @Model.Course?.Title

                    @if (Model.Course?.Teacher != null)
                    {
                        <span>
                            &nbsp; | &nbsp;
                            Giảng viên:
                            @Model.Course.Teacher.FullName
                        </span>
                    }

                </div>


                <div class="lesson-content">

                    @if (!string.IsNullOrWhiteSpace(Model.Content))
                    {
                        @Html.Raw(Model.Content)
                    }
                    else
                    {
                        <div class="alert alert-info">
                            Bài học này chưa có nội dung.
                        </div>
                    }

                </div>


                <!-- ================= NAVIGATION ================= -->

                <div class="navigation">

                    @{
                        var previousLesson =
                        Model.Course?.Lessons?
                        .Where(x =>
                        x.OrderNumber < Model.OrderNumber)
                        .OrderByDescending(x => x.OrderNumber)
                        .FirstOrDefault();

                        var nextLesson =
                        Model.Course?.Lessons?
                        .Where(x =>
                        x.OrderNumber > Model.OrderNumber)
                        .OrderBy(x => x.OrderNumber)
                        .FirstOrDefault();
                    }


                    <div>

                        @if (previousLesson != null)
                        {
                            <a href="/Lesson/Details/@previousLesson.Id"
                               class="btn-back">

                                ← Bài trước

                            </a>
                        }

                    </div>


                    <div>

                        @if (nextLesson != null)
                        {
                            <a href="/Lesson/Details/@nextLesson.Id"
                               class="btn btn-primary">

                                Bài tiếp theo →

                            </a>
                        }

                    </div>

                </div>

            </div>

        </main>

    </div>



    <!-- ============ AI TUTOR CHATBOT WIDGET ============ -->
    @{
        var tutorCtx = new ChatWidgetModel { LessonId = Model.Id, CourseId = Model.CourseId, ContextLabel = "Đang hỗ trợ bài: " + Model.Title };
    }
    @await Html.PartialAsync("_AiTutorWidget", tutorCtx)

</body>

</html>