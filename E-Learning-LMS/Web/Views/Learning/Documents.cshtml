@model IEnumerable<Web.Models.EF.PersonalDocument>

@{
    Layout = null;
    ViewData["Title"] = "Tài liệu cá nhân";
    var student = ViewBag.Student as Web.Models.EF.User;
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Tài liệu cá nhân - E-Learning</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            margin: 0;
            background: #f5f7fb;
            font-family: Arial, sans-serif;
            color: #1e293b;
        }

        .navbar {
            height: 75px;
            background: white;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            padding: 0 5%;
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
            color: #2563eb;
            text-decoration: none;
            margin-right: 35px;
        }

        .nav-item {
            margin-right: 25px;
            font-size: 15px;
            color: #334155;
            text-decoration: none;
        }

            .nav-item:hover {
                color: #2563eb;
            }

        .main {
            padding: 35px 8%;
        }

        .page-title {
            font-size: 26px;
            font-weight: bold;
            margin-bottom: 4px;
        }

        .page-sub {
            color: #64748b;
            margin-bottom: 25px;
        }

        .panel {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 22px;
        }

        .btn-main {
            background: #2563eb;
            border: none;
        }

            .btn-main:hover {
                background: #1d4ed8;
            }

        .doc-item {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 16px 18px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
        }

        .doc-icon {
            font-size: 26px;
            margin-right: 14px;
        }

        .doc-name {
            font-weight: bold;
        }

        .doc-meta {
            color: #64748b;
            font-size: 13px;
        }

        .empty-box {
            background: white;
            border: 1px dashed #cbd5e1;
            border-radius: 10px;
            padding: 40px 20px;
            text-align: center;
            color: #64748b;
        }
    </style>
</head>
<body>

    <div class="navbar">
        <a href="/" class="logo">E-Learning</a>
        <a href="/Course" class="nav-item">Chuyên mục</a>
        <a asp-controller="Learning" asp-action="MyCourses" class="nav-item">Khóa học của tôi</a>
        <a asp-controller="Learning" asp-action="Results" class="nav-item">Kết quả học tập</a>
        <a asp-controller="Learning" asp-action="Schedule" class="nav-item">Lịch học</a>
        <a asp-controller="Learning" asp-action="Documents" class="nav-item" style="color:#2563eb;font-weight:bold;">Tài liệu</a>
        <a asp-controller="Learning" asp-action="Report" class="nav-item">Báo cáo</a>
        <a asp-controller="Learning" asp-action="LookupScore" class="nav-item">Tra cứu điểm</a>
        <div style="margin-left:auto;">
            <span class="nav-item">@(student?.FullName ?? "Sinh viên")</span>
            <a asp-controller="Account" asp-action="Logout" class="nav-item">Đăng xuất</a>
        </div>
    </div>

    <div class="main">

        <div class="page-title">Tài liệu cá nhân</div>
        <div class="page-sub">Lưu trữ và quản lý các tệp tài liệu riêng của bạn (chỉ bạn xem được).</div>

        @if (!string.IsNullOrEmpty(success))
        {
            <div class="alert alert-success">@success</div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger">@error</div>
        }

        <div class="panel mb-4">
            <h6 class="fw-bold mb-3">Tải tài liệu lên</h6>

            <form asp-controller="Learning" asp-action="UploadDocument" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label">Chọn tệp (tối đa 20MB)</label>
                        <input type="file" name="file" class="form-control" required />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Ghi chú (tùy chọn)</label>
                        <input type="text" name="description" class="form-control" placeholder="VD: Bài tập chương 3" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-main text-white w-100">
                            ⬆️ Tải lên
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="panel">
            <h6 class="fw-bold mb-3">Tài liệu của tôi (@Model.Count())</h6>

            @if (Model.Any())
            {
                @foreach (var doc in Model)
                {
                    var ext = System.IO.Path.GetExtension(doc.FileName).ToLowerInvariant();
                    var icon = ext switch
                    {
                        ".pdf" => "📕",
                        ".doc" or ".docx" => "📘",
                        ".xls" or ".xlsx" => "📗",
                        ".ppt" or ".pptx" => "📙",
                        ".zip" or ".rar" => "🗜️",
                        ".jpg" or ".jpeg" or ".png" or ".gif" => "🖼️",
                        _ => "📄"
                    };
                    var sizeKb = doc.FileSize / 1024.0;
                    var sizeText = sizeKb >= 1024 ? (sizeKb / 1024.0).ToString("0.0") + " MB" : sizeKb.ToString("0") + " KB";

                    <div class="doc-item">
                        <div class="d-flex align-items-center">
                            <div class="doc-icon">@icon</div>
                            <div>
                                <div class="doc-name">@doc.FileName</div>
                                <div class="doc-meta">
                                    @sizeText • Tải lên @doc.UploadedAt.ToString("dd/MM/yyyy HH:mm")
                                    @if (!string.IsNullOrEmpty(doc.Description))
                                    {
                                        <span> • @doc.Description</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div>
                            <a href="@doc.FilePath" download="@doc.FileName" class="btn btn-sm btn-outline-primary me-2">Tải xuống</a>
                            <a asp-controller="Learning" asp-action="DeleteDocument" asp-route-id="@doc.Id"
                               class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('Xóa tài liệu này?')">Xóa</a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-box">
                    Bạn chưa có tài liệu nào. Hãy tải lên tệp đầu tiên của bạn ở trên.
                </div>
            }
        </div>

    </div>



    <!-- ============ AI TUTOR CHATBOT WIDGET ============ -->
    @{
        var tutorCtx = new ChatWidgetModel { ContextLabel = "Hỏi về tài liệu và nội dung bài học" };
    }
    @await Html.PartialAsync("_AiTutorWidget", tutorCtx)

</body>
</html>
