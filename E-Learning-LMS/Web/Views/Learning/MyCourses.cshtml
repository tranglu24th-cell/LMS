@model IEnumerable<Web.Models.EF.Enrollment>

@{
    Layout = null;
    ViewData["Title"] = "Khóa học của tôi";
    var student = ViewBag.Student as Web.Models.EF.User;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Khóa học của tôi - E-Learning</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            margin: 0;
            background: #f5f7fb;
            font-family: Arial, sans-serif;
            color: #1e293b;
        }

        .navbar {
            height: 75px;
            background: white;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            padding: 0 5%;
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
            color: #2563eb;
            text-decoration: none;
            margin-right: 35px;
        }

        .nav-item {
            margin-right: 25px;
            font-size: 15px;
            color: #334155;
            text-decoration: none;
        }

            .nav-item:hover {
                color: #2563eb;
            }

        .main {
            padding: 35px 8%;
        }

        .page-title {
            font-size: 26px;
            font-weight: bold;
            margin-bottom: 4px;
        }

        .page-sub {
            color: #64748b;
            margin-bottom: 25px;
        }

        .course-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 22px;
            height: 100%;
            transition: 0.2s;
        }

            .course-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 8px 25px rgba(0,0,0,0.08);
            }

        .course-title {
            font-weight: bold;
            font-size: 18px;
        }

        .meta {
            color: #64748b;
            font-size: 14px;
            margin-top: 8px;
        }

        .empty-box {
            background: white;
            border: 1px dashed #cbd5e1;
            border-radius: 10px;
            padding: 60px 20px;
            text-align: center;
            color: #64748b;
        }
    </style>
</head>
<body>

    <div class="navbar">
        <a href="/" class="logo">E-Learning</a>
        <a href="/Course" class="nav-item">Chuyên mục</a>
        <a asp-controller="Learning" asp-action="MyCourses" class="nav-item" style="color:#2563eb;font-weight:bold;">Khóa học của tôi</a>
        <a asp-controller="Learning" asp-action="Results" class="nav-item">Kết quả học tập</a>
        <a asp-controller="Learning" asp-action="Schedule" class="nav-item">Lịch học</a>
        <a asp-controller="Learning" asp-action="Documents" class="nav-item">Tài liệu</a>
        <a asp-controller="Learning" asp-action="Report" class="nav-item">Báo cáo</a>
        <a asp-controller="Learning" asp-action="LookupScore" class="nav-item">Tra cứu điểm</a>
        <div style="margin-left:auto;">
            <span class="nav-item">@(student?.FullName ?? "Sinh viên")</span>
            <a asp-controller="Account" asp-action="Logout" class="nav-item">Đăng xuất</a>
        </div>
    </div>

    <div class="main">

        <div class="page-title">Khóa học của tôi</div>
        <div class="page-sub">Danh sách các khóa học bạn đã đăng ký.</div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-4">
                @foreach (var enrollment in Model)
                {
                    var course = enrollment.Course;
                    if (course == null) { continue; }

                    <div class="col-lg-4 col-md-6">
                        <div class="course-card">
                            <div class="course-title">@course.Title</div>
                            <p class="text-muted mt-2 mb-1">
                                @(string.IsNullOrEmpty(course.Description) ? "Chưa có mô tả cho khóa học này." : course.Description)
                            </p>
                            <div class="meta">👤 @(course.Teacher?.FullName ?? course.Teacher?.Username ?? "Chưa cập nhật")</div>
                            <div class="meta">📚 @course.Lessons.Count bài học</div>
                            <div class="meta">🗓️ Đăng ký ngày @enrollment.EnrolledAt.ToString("dd/MM/yyyy")</div>

                            <a asp-controller="Course" asp-action="Details" asp-route-id="@course.Id"
                               class="btn btn-primary w-100 mt-3 rounded-3">
                                Vào học
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-box">
                <p class="mb-3">Bạn chưa đăng ký khóa học nào.</p>
                <a asp-controller="Course" asp-action="Index" class="btn btn-outline-primary">Khám phá khóa học</a>
            </div>
        }

    </div>



    <!-- ============ AI TUTOR CHATBOT WIDGET ============ -->
    @{
        var tutorCtx = new ChatWidgetModel { ContextLabel = "Hỏi về các khóa bạn đang học" };
    }
    @await Html.PartialAsync("_AiTutorWidget", tutorCtx)

</body>
</html>
