@model IEnumerable<Web.Models.EF.Grade>

@{
    Layout = null;
    ViewData["Title"] = "Tra cứu điểm";
    var student = ViewBag.Student as Web.Models.EF.User;
    var error = ViewBag.Error as string;
    double? average = ViewBag.AverageScore;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Tra cứu điểm - E-Learning</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            margin: 0;
            background: #f5f7fb;
            font-family: Arial, sans-serif;
            color: #1e293b;
        }

        .navbar {
            height: 75px;
            background: white;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            padding: 0 5%;
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
            color: #2563eb;
            text-decoration: none;
            margin-right: 35px;
        }

        .nav-item {
            margin-right: 25px;
            font-size: 15px;
            color: #334155;
            text-decoration: none;
        }

            .nav-item:hover {
                color: #2563eb;
            }

        .main {
            padding: 35px 8%;
            max-width: 900px;
            margin: 0 auto;
        }

        .page-title {
            font-size: 26px;
            font-weight: bold;
            margin-bottom: 4px;
            text-align: center;
        }

        .page-sub {
            color: #64748b;
            margin-bottom: 25px;
            text-align: center;
        }

        .panel {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 30px;
        }

        .btn-main {
            background: #2563eb;
            border: none;
        }

            .btn-main:hover {
                background: #1d4ed8;
            }

        .score-badge {
            font-weight: bold;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 14px;
        }

        .score-good { background: #dcfce7; color: #15803d; }
        .score-mid { background: #fef9c3; color: #a16207; }
        .score-bad { background: #fee2e2; color: #b91c1c; }

        .result-header {
            background: #eef4ff;
            border-radius: 10px;
            padding: 18px 22px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>

    <div class="navbar">
        <a href="/" class="logo">E-Learning</a>
        <a href="/Course" class="nav-item">Chuyên mục</a>
        <a asp-controller="Learning" asp-action="MyCourses" class="nav-item">Khóa học của tôi</a>
        <a asp-controller="Learning" asp-action="Results" class="nav-item">Kết quả học tập</a>
        <a asp-controller="Learning" asp-action="Schedule" class="nav-item">Lịch học</a>
        <a asp-controller="Learning" asp-action="Documents" class="nav-item">Tài liệu</a>
        <a asp-controller="Learning" asp-action="Report" class="nav-item">Báo cáo</a>
        <a asp-controller="Learning" asp-action="LookupScore" class="nav-item" style="color:#2563eb;font-weight:bold;">Tra cứu điểm</a>
        <div style="margin-left:auto;">
            <a asp-controller="Account" asp-action="Login" class="nav-item">Đăng nhập</a>
        </div>
    </div>

    <div class="main">

        <div class="page-title">Tra cứu điểm</div>
        <div class="page-sub">Nhập MSSV và Họ tên để tra cứu điểm học tập của bạn.</div>

        <div class="panel mb-4">

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger">@error</div>
            }

            <form asp-controller="Learning" asp-action="LookupScore" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">MSSV</label>
                        <input type="text" name="mssv" class="form-control p-2" placeholder="VD: 2126xxxx" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Họ và tên</label>
                        <input type="text" name="fullName" class="form-control p-2" placeholder="Nguyễn Văn A" required />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-main text-white px-4 py-2 rounded-3">
                            🔍 Tra cứu
                        </button>
                    </div>
                </div>
            </form>
        </div>

        @if (student != null)
        {
            <div class="panel">

                <div class="result-header d-flex justify-content-between align-items-center flex-wrap">
                    <div>
                        <strong>@student.FullName</strong>
                        <div class="text-muted small">MSSV: @student.MSSV @(string.IsNullOrEmpty(student.ClassName) ? "" : $"• Lớp: {student.ClassName}")</div>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold" style="font-size:22px;color:#2563eb;">
                            @(average.HasValue ? average.Value.ToString("0.00") : "--")
                        </div>
                        <div class="text-muted small">Điểm trung bình</div>
                    </div>
                </div>

                @if (Model != null && Model.Any())
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Khóa học</th>
                                <th>Điểm</th>
                                <th>Nhận xét</th>
                                <th>Ngày chấm</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var grade in Model)
                            {
                                var badgeClass = grade.Score >= 8 ? "score-good" : grade.Score >= 5 ? "score-mid" : "score-bad";
                                <tr>
                                    <td>@(grade.Course?.Title ?? "Khóa học")</td>
                                    <td><span class="score-badge @badgeClass">@grade.Score.ToString("0.##")</span></td>
                                    <td>@(string.IsNullOrEmpty(grade.Comment) ? "-" : grade.Comment)</td>
                                    <td>@grade.GradedAt.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted mb-0 mt-3">Sinh viên chưa có điểm nào được cập nhật.</p>
                }

            </div>
        }

    </div>



    <!-- ============ AI TUTOR CHATBOT WIDGET ============ -->
    @{
        var tutorCtx = new ChatWidgetModel { ContextLabel = "Giải thích khái niệm & thang điểm" };
    }
    @await Html.PartialAsync("_AiTutorWidget", tutorCtx)

</body>
</html>
