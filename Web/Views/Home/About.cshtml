@{
    ViewData["Title"] = "Giới thiệu về E-Learning";
    Layout = "~/Views/Shared/_Site.cshtml"; 
}
<div class="container-fluid bg-light py-6 my-6 mt-0">
    <div class="container text-center animated bounceInDown">
        <h1 class="display-1 mb-4 active">Giới thiệu</h1>
    </div>
</div>

<div class="container-fluid py-6" style="padding-top: 120px;">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5 wow bounceInUp" data-wow-delay="0.1s">
                <img src="~/img/gthieu.jpg" class="img-fluid rounded shadow" alt="About E-Learning">
            </div>
            <div class="col-lg-7 wow bounceInUp" data-wow-delay="0.3s">
                <small class="d-inline-block fw-bold text-dark text-uppercase bg-light border border-primary rounded-pill px-4 py-1 mb-3">
                    Giới thiệu
                </small>
                <h1 class="display-5 mb-4">Hơn 200+ học viên đã tin tưởng lựa chọn</h1>
                <p class="mb-4 text-muted">
                    Chào mừng bạn đến với E-Learning! Chúng tôi mang đến nền tảng học trực tuyến hiện đại, nơi học viên và giảng viên cùng trao đổi kiến thức, theo dõi tiến độ học tập và làm bài kiểm tra mọi lúc, mọi nơi. Sự tiến bộ của bạn trong từng khóa học chính là động lực lớn nhất của chúng tôi.
                </p>
                <div class="row g-4 text-dark mb-5">
                    <div class="col-sm-6">
                        <i class="fas fa-check text-primary me-2"></i>Bài giảng cập nhật mỗi ngày
                    </div>
                    <div class="col-sm-6">
                        <i class="fas fa-check text-primary me-2"></i>Học mọi lúc, mọi nơi
                    </div>
                    <div class="col-sm-6">
                        <i class="fas fa-check text-primary me-2"></i>Hỗ trợ giải đáp thắc mắc trực tiếp
                    </div>
                    <div class="col-sm-6">
                        <i class="fas fa-check text-primary me-2"></i>Theo dõi kết quả học tập chi tiết
                    </div>
                </div>
                <a href="@Url.Action("Index", "Lesson")" class="btn btn-primary py-3 px-5 rounded-pill">
                    Xem khóa học <i class="fas fa-arrow-right ps-2"></i>
                </a>
            </div>
        </div>
    </div>
</div>