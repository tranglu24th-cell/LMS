@model IEnumerable<Web.Models.EF.Course>

@{
    Layout = null;
    ViewData["Title"] = "Lịch học";
    var student = ViewBag.Student as Web.Models.EF.User;

    string[] dayNames = { "Chủ nhật", "Thứ hai", "Thứ ba", "Thứ tư", "Thứ năm", "Thứ sáu", "Thứ bảy" };

    var scheduled = Model.Where(c => c.ScheduleDayOfWeek.HasValue).ToList();
    var unscheduled = Model.Where(c => !c.ScheduleDayOfWeek.HasValue).ToList();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Lịch học - E-Learning</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            margin: 0;
            background: #f5f7fb;
            font-family: Arial, sans-serif;
            color: #1e293b;
        }

        .navbar {
            height: 75px;
            background: white;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            padding: 0 5%;
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
            color: #2563eb;
            text-decoration: none;
            margin-right: 35px;
        }

        .nav-item {
            margin-right: 25px;
            font-size: 15px;
            color: #334155;
            text-decoration: none;
        }

            .nav-item:hover {
                color: #2563eb;
            }

        .main {
            padding: 35px 8%;
        }

        .page-title {
            font-size: 26px;
            font-weight: bold;
            margin-bottom: 4px;
        }

        .page-sub {
            color: #64748b;
            margin-bottom: 25px;
        }

        .panel {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 22px;
        }

        .day-group {
            margin-bottom: 22px;
        }

        .day-label {
            display: inline-block;
            background: #eef4ff;
            color: #2563eb;
            font-weight: bold;
            padding: 6px 16px;
            border-radius: 20px;
            margin-bottom: 12px;
            font-size: 14px;
        }

        .schedule-item {
            border: 1px solid #e5e7eb;
            border-left: 4px solid #2563eb;
            border-radius: 8px;
            padding: 14px 18px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .schedule-title {
            font-weight: bold;
        }

        .schedule-meta {
            color: #64748b;
            font-size: 14px;
        }

        .time-badge {
            background: #f1f5f9;
            color: #334155;
            padding: 6px 14px;
            border-radius: 8px;
            font-weight: bold;
            font-size: 14px;
            white-space: nowrap;
        }

        .empty-box {
            background: white;
            border: 1px dashed #cbd5e1;
            border-radius: 10px;
            padding: 40px 20px;
            text-align: center;
            color: #64748b;
        }

      
    </style>
</head>
<body>

    <div class="navbar">
        <a href="/" class="logo">E-Learning</a>
        <a href="/Lesson" class="nav-item">Chuyên mục</a>
        <a asp-controller="Learning" asp-action="MyCourses" class="nav-item">Khóa học của tôi</a>
        <a asp-controller="Learning" asp-action="Results" class="nav-item">Kết quả học tập</a>
        <a asp-controller="Learning" asp-action="Schedule" class="nav-item" style="color:#2563eb;font-weight:bold;">Lịch học</a>
        <a asp-controller="Learning" asp-action="Documents" class="nav-item">Tài liệu</a>
        <a asp-controller="Learning" asp-action="Report" class="nav-item">Báo cáo</a>
        <a asp-controller="Learning"
           asp-action="LookupScore"
           class="nav-item">
            Tra cứu điểm
        </a>
        <div style="margin-left:auto;">
            <span class="nav-item">@(student?.FullName ?? "Sinh viên")</span>
            <a asp-controller="Account" asp-action="Logout" class="nav-item">Đăng xuất</a>
        </div>
    </div>

    <div class="main">

        <div class="page-title">Lịch học</div>
        <div class="page-sub">Thời khóa biểu các khóa học bạn đã đăng ký.</div>

        <div class="panel">

            @if (scheduled.Any())
            {
                @foreach (var dayGroup in scheduled
                   .GroupBy(c => c.ScheduleDayOfWeek!.Value)
                   .OrderBy(g => g.Key))
                {
                    <div class="day-group">
                        <div class="day-label">📅 @dayNames[dayGroup.Key]</div>

                        @foreach (var course in dayGroup.OrderBy(c => c.ScheduleStartTime ?? TimeSpan.Zero))
                        {
                            <div class="schedule-item">
                                <div>
                                    <div class="schedule-title">@course.Title</div>
                                    <div class="schedule-meta">
                                        👤 @(course.Teacher?.FullName ?? "Chưa cập nhật")
                                        @if (!string.IsNullOrEmpty(course.Room))
                                        {
                                            <span> • 📍 Phòng @course.Room</span>
                                        }
                                    </div>
                                </div>

                                <div class="time-badge">
                                    @(course.ScheduleStartTime.HasValue ? course.ScheduleStartTime.Value.ToString(@"hh\:mm") : "--:--")
                                    -
                                    @(course.ScheduleEndTime.HasValue ? course.ScheduleEndTime.Value.ToString(@"hh\:mm") : "--:--")
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="empty-box mb-4">
                    Chưa có khóa học nào được thiết lập lịch học cụ thể.
                </div>
            }

            @if (unscheduled.Any())
            {
                <div class="day-group">
                    <div class="day-label" style="background:#fef9c3;color:#a16207;">🕓 Chưa có lịch cố định</div>

                    @foreach (var course in unscheduled)
                    {
                        <div class="schedule-item" style="border-left-color:#cbd5e1;">
                            <div>
                                <div class="schedule-title">@course.Title</div>
                                <div class="schedule-meta">👤 @(course.Teacher?.FullName ?? "Chưa cập nhật")</div>
                            </div>
                            <span class="text-muted small">Liên hệ giảng viên để biết thêm chi tiết</span>
                        </div>
                    }
                </div>
            }

        </div>

    </div>



    <!-- ============ AI TUTOR CHATBOT WIDGET ============ -->
    @{
        var tutorCtx = new ChatWidgetModel { ContextLabel = "Hỏi về lịch học và nội dung khóa" };
    }
    @await Html.PartialAsync("_AiTutorWidget", tutorCtx)

</body>
</html>
