@model Web.Models.EF.Course
@using Web.Models.EF

@{
    ViewData["Title"] = Model.Title;
    Layout = null;

    var isEn = Context.Request.Cookies["lang"] == "en";

    string accountName =
        User.Identity?.Name
        ?? "Tài khoản";

    string accountLetter =
        string.IsNullOrWhiteSpace(accountName)
            ? "U"
            : accountName.Substring(0, 1).ToUpper();

    bool isCourseTeacher =
        ViewBag.IsCourseTeacher == true;

    var chapters = Model.CourseChapters?
        .OrderBy(x => x.OrderNumber)
        .ThenBy(x => x.Id)
        .ToList()
        ?? new List<CourseChapter>();

    var lessons = Model.Lessons?
        .OrderBy(x => x.ChapterId)
        .ThenBy(x => x.OrderNumber)
        .ThenBy(x => x.Id)
        .ToList()
        ?? new List<Lesson>();

    var lessonSections = Model.LessonSections?
        .OrderBy(x => x.OrderNumber)
        .ThenBy(x => x.Id)
        .ToList()
        ?? new List<LessonSection>();

    int nextChapterOrder =
        chapters.Any()
            ? chapters.Max(x => x.OrderNumber) + 1
            : 1;

    int nextSectionOrder =
        lessonSections.Any()
            ? lessonSections.Max(x => x.OrderNumber) + 1
            : 1;

    string teacherName =
        Model.Teacher?.FullName
        ?? Model.Teacher?.Username
        ?? "Chưa cập nhật";

    string teacherLetter =
        string.IsNullOrWhiteSpace(teacherName)
            ? "T"
            : teacherName.Substring(0, 1).ToUpper();

    string courseDescription =
        string.IsNullOrWhiteSpace(Model.Description)
            ? "Chưa có mô tả cho khóa học này."
            : Model.Description;
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @Model.Title - E-Learning
    </title>


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />


    <style>

    .quiz-inline-box {
        margin-top: 25px;
        padding: 20px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #f8fafc;
    }

    .quiz-inline-header {
        padding-bottom: 15px;
        border-bottom: 1px solid #e2e8f0;
    }

    .quiz-question-card {
        margin-bottom: 16px;
        padding: 18px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: white;
    }

    .quiz-option-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        margin-bottom: 8px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
    }

    .quiz-option-letter {
        width: 28px;
        height: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f1f5f9;
        font-weight: 700;
    }

    .quiz-add-question {
        padding: 20px;
        border: 1px dashed #94a3b8;
        border-radius: 10px;
        background: white;
    }


        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f7fb;
            color: #1e293b;
        }

        a {
            text-decoration: none;
        }


        /* =====================================================
                   TOPBAR
                ===================================================== */

        .topbar {
            height: 58px;
            background: #ffffff;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            padding: 0 20px;
        }

        .logo {
            font-size: 21px;
            font-weight: 700;
            color: #2563eb;
            text-decoration: none;
            margin-right: 32px;
            white-space: nowrap;
        }

        .top-link {
            text-decoration: none;
            color: #334155;
            padding: 20px 17px;
            font-size: 13px;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: 0.2s;
        }
            .top-link:hover {
                color: #2563eb;
                background: #f8fafc;
            }

            .top-link.active {
                color: #2563eb;
                font-weight: 600;
            }

        /* =====================================================
                   ACCOUNT MENU
                ===================================================== */

        .user-area {
            margin-left: auto;
            position: relative;
        }

        .account-dropdown {
            position: relative;
        }

        .account-button {
            border: none;
            background: transparent;
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            padding: 4px 8px;
            color: #1e293b;
            font-size: 15px;
        }

            .account-button:hover {
                color: #2563eb;
            }

        .account-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #34495e;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: bold;
        }

        .account-name {
            max-width: 130px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .account-arrow {
            font-size: 12px;
        }

        .account-menu {
            position: absolute;
            top: 52px;
            right: 0;
            width: 295px;
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 6px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.12);
            padding: 8px 0;
            display: none;
            z-index: 99999;
        }

            .account-menu.show {
                display: block;
            }

        .account-menu-item {
            display: flex;
            align-items: center;
            gap: 15px;
            min-height: 55px;
            padding: 0 25px;
            text-decoration: none;
            color: #111827;
            font-size: 16px;
        }

            .account-menu-item:hover {
                background: #f5f7fb;
                color: #2563eb;
            }

            .account-menu-item i:first-child {
                width: 22px;
                font-size: 20px;
                text-align: center;
                color: #111827;
            }

            .account-menu-item:hover i:first-child {
                color: #2563eb;
            }

        .account-divider {
            height: 1px;
            background: #e5e7eb;
            margin: 7px 0;
        }

        .language-item {
            cursor: default;
        }

            .language-item:hover {
                background: transparent;
                color: #111827;
            }

                .language-item:hover i:first-child {
                    color: #111827;
                }

        .language-title {
            flex: 1;
        }

        .language-buttons {
            margin-left: auto;
            display: flex;
            gap: 6px;
            align-items: center;
        }

        .language-btn {
            font-size: 12px;
            padding: 2px 8px;
            border-radius: 6px;
            text-decoration: none;
        }

            .language-btn.active {
                background: #2563eb;
                color: #ffffff;
            }

            .language-btn.inactive {
                background: #f1f5f9;
                color: #334155;
            }

            .language-btn:hover {
                text-decoration: none;
            }

        .logout-item:hover {
            background: #fff1f1;
            color: #dc2626;
        }

            .logout-item:hover i:first-child {
                color: #dc2626 !important;
            }

        .account-login-link {
            text-decoration: none;
            color: #334155;
            font-size: 15px;
        }

            .account-login-link:hover {
                color: #2563eb;
            }


        /* =====================================================
                   LAYOUT
                ===================================================== */

        .layout {
            display: flex;
            min-height: calc(100vh - 58px);
        }


        /* =====================================================
                   SIDEBAR
                ===================================================== */

        .sidebar {
            width: 340px;
            min-width: 340px;
            background: white;
            border-right: 1px solid #dbe1ea;
            overflow-y: auto;
            min-height: calc(100vh - 58px);
        }

        .sidebar-title {
            padding: 18px 20px;
            font-size: 16px;
            font-weight: bold;
            border-bottom: 1px solid #e5e7eb;
            color: #1e293b;
        }

        .sidebar-group-title {
            padding: 12px 18px;
            background: #f8fafc;
            border-bottom: 1px solid #e5e7eb;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            color: #64748b;
        }


        /* =====================================================
                   DYNAMIC LESSON SECTION SIDEBAR
                ===================================================== */

        .sidebar-section-link {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 18px;
            border: none;
            border-bottom: 1px solid #eef2f7;
            background: white;
            color: #334155;
            text-align: left;
            font-size: 14px;
        }

            .sidebar-section-link:hover {
                background: #f8fafc;
                color: #2563eb;
            }

            .sidebar-section-link i {
                color: #38a3c7;
            }


        /* =====================================================
                   CHAPTER SIDEBAR
                ===================================================== */

        .chapter {
            border-bottom: 1px solid #e5e7eb;
        }

        .chapter-header {
            width: 100%;
            border: none;
            background: white;
            padding: 15px 18px;
            display: flex;
            align-items: center;
            gap: 8px;
            text-align: left;
            cursor: pointer;
            font-size: 15px;
            font-weight: bold;
            color: #1e293b;
        }

            .chapter-header:hover {
                background: #f8fafc;
            }

        .chapter-arrow {
            width: 18px;
            min-width: 18px;
            color: #64748b;
            font-size: 12px;
        }

        .chapter-content {
            display: none;
            background: #fafbfc;
        }

            .chapter-content.show {
                display: block;
            }

        .lesson-type {
            border-top: 1px solid #eef2f7;
        }

        .lesson-type-header {
            width: 100%;
            border: none;
            background: transparent;
            padding: 11px 18px 11px 38px;
            display: flex;
            align-items: center;
            gap: 7px;
            text-align: left;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            color: #475569;
        }

            .lesson-type-header:hover {
                background: #f1f5f9;
            }

        .type-arrow {
            width: 18px;
            min-width: 18px;
            color: #64748b;
            font-size: 12px;
        }

        .lesson-type-content {
            display: none;
        }

            .lesson-type-content.show {
                display: block;
            }

        .lesson-item {
            width: 100%;
            border: none;
            background: transparent;
            padding: 10px 15px 10px 65px;
            display: flex;
            align-items: flex-start;
            gap: 5px;
            text-align: left;
            cursor: pointer;
            font-size: 14px;
            color: #475569;
        }

            .lesson-item:hover {
                background: #eaf2ff;
                color: #2563eb;
            }

        .lesson-number {
            min-width: 22px;
        }


        /* =====================================================
                   MAIN
                ===================================================== */

        .main {
            flex: 1;
            padding: 35px;
            max-width: 1400px;
            margin: auto;
            width: 100%;
        }


        /* =====================================================
                   COURSE BANNER
                ===================================================== */

        .course-banner {
            min-height: 280px;
            border-radius: 10px;
            overflow: hidden;
            position: relative;
            background: #1e3a8a;
            display: flex;
            align-items: flex-end;
            padding: 35px;
            color: white;
        }

        .course-banner-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.42;
        }

        .course-banner-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.35);
        }

        .course-info {
            position: relative;
            z-index: 2;
            max-width: 900px;
        }

        .course-label {
            display: inline-block;
            background: white;
            color: #475569;
            padding: 5px 12px;
            border-radius: 15px;
            font-size: 13px;
            margin-bottom: 10px;
        }

        .course-title {
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .teacher {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .teacher-avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
        }


        /* =====================================================
                   TABS
                ===================================================== */

        .tabs {
            background: white;
            border-bottom: 1px solid #dbe1ea;
            display: flex;
            overflow-x: auto;
        }

        .tab {
            padding: 18px 20px;
            text-decoration: none;
            color: #334155;
            white-space: nowrap;
            cursor: pointer;
        }

            .tab:hover {
                background: #f8fafc;
            }

            .tab.active {
                color: #2563eb;
                border-bottom: 3px solid #2563eb;
                font-weight: bold;
            }


        /* =====================================================
                   TOOLBAR
                ===================================================== */

        .teacher-toolbar {
            background: white;
            border: 1px solid #dbe1ea;
            border-radius: 10px;
            padding: 18px 20px;
            margin-top: 20px;
            margin-bottom: 25px;
        }

        .teacher-toolbar-title {
            font-weight: bold;
            font-size: 16px;
            margin-bottom: 13px;
            color: #1e293b;
        }

        .teacher-toolbar-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .teacher-btn {
            border: none;
            border-radius: 6px;
            padding: 9px 14px;
            font-size: 14px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            cursor: pointer;
        }

        .teacher-btn-primary {
            background: #2563eb;
            color: white;
        }

        .teacher-btn-success {
            background: #198754;
            color: white;
        }

        .teacher-btn-info {
            background: #0ea5e9;
            color: white;
        }

        .teacher-btn:hover {
            opacity: 0.9;
            color: white;
        }


        /* =====================================================
                   CONTENT
                ===================================================== */

        .content {
            margin-top: 30px;
        }

        .tab-content-box {
            width: 100%;
        }


        /* =====================================================
                   DESCRIPTION
                ===================================================== */

        .description {
            background: white;
            padding: 25px;
            border-radius: 10px;
            border: 1px solid #e5e7eb;
            margin-bottom: 25px;
        }

            .description h3 {
                color: #2563eb;
                font-size: 21px;
                margin-bottom: 15px;
            }

            .description p {
                color: #475569;
                line-height: 1.8;
                margin-bottom: 0;
            }


        /* =====================================================
                   DYNAMIC COURSE SECTION
                ===================================================== */

        .dynamic-section {
            background: white;
            border: 1px solid #dbe1ea;
            margin-bottom: 18px;
            border-radius: 6px;
            overflow: hidden;
        }

        .dynamic-section-header {
            padding: 14px 20px;
            font-size: 15px;
            font-weight: bold;
            color: #1e293b;
            background: #f8fafc;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .dynamic-section-title {
            display: flex;
            align-items: center;
            gap: 9px;
            min-width: 0;
        }

            .dynamic-section-title i {
                color: #38a3c7;
            }

        .dynamic-section-body {
            padding: 22px;
            color: #475569;
            line-height: 1.8;
        }

            .dynamic-section-body img {
                max-width: 100%;
                height: auto;
            }

        .dynamic-section-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

        .section-number {
            color: #64748b;
            font-size: 13px;
        }


        /* =====================================================
                   SECTION FILE
                ===================================================== */

        .section-file {
            margin-top: 18px;
            padding: 14px;
            background: #f8fafc;
            border: 1px solid #dbe1ea;
            border-radius: 8px;
        }

            .section-file a {
                color: #2563eb;
            }


        /* =====================================================
                   EDIT BOX
                ===================================================== */

        .edit-box {
            background: #f8fafc;
            border-top: 1px solid #dbe1ea;
            padding: 20px;
        }


        /* =====================================================
                   MAIN CHAPTER
                ===================================================== */

        .main-chapter {
            margin-top: 25px;
            background: white;
            border: 1px solid #dbe1ea;
        }

        .main-chapter-title {
            padding: 14px 20px;
            background: #eef4ff;
            color: #1e40af;
            font-size: 17px;
            font-weight: bold;
            border-bottom: 1px solid #dbe1ea;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .chapter-title-text {
            display: flex;
            align-items: center;
            gap: 5px;
            min-width: 0;
        }


        /* =====================================================
                   LESSON ROW
                ===================================================== */

        .main-lesson-type {
            padding: 14px 20px;
            font-weight: bold;
            font-size: 14px;
            color: #475569;
            background: #fafbfc;
            border-bottom: 1px solid #e5e7eb;
        }

        .main-lesson-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0;
            border-bottom: 1px solid #e5e7eb;
            background: white;
        }

            .main-lesson-row:last-child {
                border-bottom: none;
            }

            .main-lesson-row:hover {
                background: #f8fafc;
            }

        .main-lesson-select {
            flex: 1;
            min-width: 0;
        }

            .main-lesson-select button {
                width: 100%;
                padding: 13px 20px;
                border: none;
                background: transparent;
                text-align: left;
                color: #2563eb;
                cursor: pointer;
                font-size: 14px;
            }

                .main-lesson-select button:hover {
                    background: #f8fafc;
                }


        /* =====================================================
                   LESSON VIEW
                ===================================================== */

        .lesson-view {
            background: white;
            border: 1px solid #dbe1ea;
            border-radius: 10px;
            overflow: hidden;
            min-height: 350px;
            margin-top: 25px;
        }

        .lesson-view-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

            .lesson-view-actions form {
                margin: 0;
            }

        .lesson-view-header {
            padding: 20px 25px;
            border-bottom: 1px solid #e5e7eb;
            background: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .lesson-view-order {
            font-size: 13px;
            color: #64748b;
            margin-bottom: 5px;
        }

        .lesson-view-title {
            font-size: 24px;
            font-weight: bold;
            color: #1e293b;
        }

        .lesson-view-body {
            padding: 30px 25px;
            line-height: 1.7;
            color: #334155;
        }

            .lesson-view-body img {
                max-width: 100%;
                height: auto;
            }

        .lesson-placeholder {
            padding: 60px 25px;
            text-align: center;
            color: #64748b;
        }

        .lesson-placeholder-icon {
            font-size: 45px;
            margin-bottom: 15px;
        }

        .lesson-attachment-box {
            margin: 0 25px 25px 25px;
            padding: 18px;
            border: 1px solid #dbe1ea;
            border-radius: 8px;
            background: #f8fafc;
        }

        .lesson-attachment-title {
            font-weight: 600;
            margin-bottom: 10px;
            color: #334155;
        }

        .lesson-attachment-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            padding: 9px 14px;
            border-radius: 6px;
            background: white;
            border: 1px solid #cbd5e1;
            color: #2563eb;
        }

            .lesson-attachment-link:hover {
                background: #eff6ff;
                border-color: #93c5fd;
            }


        /* =====================================================
                   MOODLE
                ===================================================== */

        .moodle-box {
            background: #ffffff;
            border: 1px solid #d8dee6;
            padding: 24px;
        }

        .moodle-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .moodle-description {
            color: #555;
            margin-bottom: 22px;
        }

        .participant-filter {
            background: #f8f9fa;
            border: 1px solid #d8dee6;
            padding: 20px;
            margin-bottom: 20px;
        }

        .filter-row {
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .filter-row select {
                min-width: 180px;
                height: 42px;
                border: 1px solid #cbd5e1;
                border-radius: 4px;
                padding: 0 12px;
                background: white;
            }

        .participant-count {
            font-size: 17px;
            margin: 18px 0;
        }

        .participant-table {
            width: 100%;
            border-collapse: collapse;
        }

            .participant-table th,
            .participant-table td {
                border: 1px solid #d8dee6;
                padding: 13px;
                vertical-align: middle;
            }

            .participant-table th {
                background: #eef0f2;
                font-weight: 600;
            }

            .participant-table tbody tr:hover {
                background: #f8fafc;
            }

        .avatar-small {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #607d8b;
            color: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }


        /* =====================================================
                   EMPTY
                ===================================================== */

        .empty {
            background: white;
            padding: 40px;
            text-align: center;
            color: #64748b;
            border: 1px solid #dbe1ea;
            border-radius: 10px;
        }

        /* =====================================================
           ACTION BUTTON - ẨN MẶC ĐỊNH
        ===================================================== */

        .dynamic-section-actions,
        .section-view-actions,
        .section-content-actions,
        .lesson-row-actions,
        .lesson-view-actions,
        .hover-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.18s ease, visibility 0.18s ease;
        }


        /* =====================================================
           HOVER - HIỆN NÚT
        ===================================================== */

        /* Nội dung học phần */
        .dynamic-section:hover .dynamic-section-actions {
            opacity: 1;
            visibility: visible;
        }


        /* Nội dung học phần - tiêu đề */
        .section-view-header:hover .section-view-actions {
            opacity: 1;
            visibility: visible;
        }


        /* Nội dung học phần - phần nội dung */
        .section-content-row:hover .section-content-actions {
            opacity: 1;
            visibility: visible;
        }


        /* Nội dung giảng dạy - chi tiết bài */
        .lesson-view-header:hover .lesson-view-actions {
            opacity: 1;
            visibility: visible;
        }


        /* Danh sách chương / bài */
        .chapter-header:hover .hover-actions,
        .main-chapter-title:hover .hover-actions,
        .main-lesson-row:hover .hover-actions {
            opacity: 1;
            visibility: visible;
        }


        /* Danh sách bài giảng */
        .main-lesson-row:hover .lesson-row-actions {
            opacity: 1;
            visibility: visible;
        }


        /* =====================================================
           FORM
        ===================================================== */

        .dynamic-section-actions form,
        .section-view-actions form,
        .section-content-actions form,
        .lesson-row-actions form,
        .lesson-view-actions form,
        .hover-actions form {
            margin: 0;
        }


        /* =====================================================
           NÚT ICON
        ===================================================== */

        .hover-action-btn {
            width: 30px;
            height: 30px;
            border: 1px solid #cbd5e1;
            background: white;
            border-radius: 5px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            cursor: pointer;
            transition: 0.15s;
        }


            .hover-action-btn i {
                font-size: 14px;
            }


        /* Sửa */
        .hover-edit {
            color: #2563eb;
        }

            .hover-edit:hover {
                background: #eff6ff;
                border-color: #93c5fd;
            }


        /* Xóa */
        .hover-delete {
            color: #dc2626;
        }

            .hover-delete:hover {
                background: #fef2f2;
                border-color: #fca5a5;
            }
        /* =====================================================
           SECTION VIEW
        ===================================================== */

       

        .section-view-header {
            padding: 16px 20px;
            background: #eef4ff;
            border-bottom: 1px solid #dbe1ea;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .section-view-title {
            font-size: 20px;
            font-weight: 700;
            color: #2563eb;
        }

        .section-view-type {
            padding: 12px 20px;
            background: #fafbfc;
            border-bottom: 1px solid #e5e7eb;
            color: #475569;
            font-size: 14px;
            font-weight: 700;
        }

        .section-view-body {
            padding: 22px 20px;
            color: #334155;
            line-height: 1.8;
            font-size: 15px;
            min-height: 100px;
        }
        /* =====================================================
           NỘI DUNG CHI TIẾT - SỬA / XÓA RIÊNG
        ===================================================== */

        .section-content-row {
            display: flex;
            align-items: flex-start;
            gap: 15px;
        }

        .section-content-text {
            flex: 1;
            min-width: 0;
        }

        .section-content-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.18s ease, visibility 0.18s ease;
        }

        .section-content-row:hover .section-content-actions {
            opacity: 1;
            visibility: visible;
        }

        .section-content-actions form {
            margin: 0;
        }

            .section-view-body img {
                max-width: 100%;
                height: auto;
            }

        .section-view-attachment {
            margin-top: 18px;
            padding-top: 14px;
            border-top: 1px solid #eef2f7;
        }

            .section-view-attachment a {
                color: #2563eb;
                text-decoration: none;
            }

                .section-view-attachment a:hover {
                    text-decoration: underline;
                }


        /* =====================================================
           SECTION CONTENT
        ===================================================== */

        .section-content-row {
            display: flex;
            align-items: flex-start;
            gap: 15px;
        }

        .section-content-text {
            flex: 1;
            min-width: 0;
        }

        .section-content-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }


        /* =====================================================
           LESSON VIEW
        ===================================================== */

        .lesson-view-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

            .lesson-view-actions form {
                margin: 0;
            }


        /* =====================================================
           ACTIVE SIDEBAR
        ===================================================== */

        .section-small-title.active-section {
            background: #eaf2ff !important;
            color: #2563eb !important;
        }

            .section-small-title.active-section .type-arrow {
                color: #2563eb !important;
            }

        .section-small-title {
            background: #fff !important;
            border-bottom: 1px solid #eef2f7 !important;
            color: #475569 !important;
            font-size: 13px;
            font-weight: 400;
            text-align: left;
            padding: 9px 14px 9px 20px !important;
        }

            .section-small-title:hover {
                background: #f8fafc !important;
                color: #2563eb !important;
            }

            .section-small-title .type-arrow {
                color: #94a3b8;
                font-size: 12px;
                margin-right: 6px;
            }

        .section-detail-content {
            border-bottom: 1px solid #e5e7eb;
        }
        /* =====================================================
           SECTION VIEW - NỘI DUNG HỌC PHẦN ĐƯỢC CHỌN
        ===================================================== */

        .section-view {
            background: #ffffff;
            border: 1px solid #dbe1ea;
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 25px;
        }

        .section-view-header {
            padding: 16px 20px;
            background: #eef4ff;
            border-bottom: 1px solid #dbe1ea;
        }

        .section-view-title {
            font-size: 20px;
            font-weight: 700;
            color: #2563eb;
        }

        .section-view-type {
            padding: 12px 20px;
            background: #fafbfc;
            border-bottom: 1px solid #e5e7eb;
            color: #475569;
            font-size: 14px;
            font-weight: 700;
        }

        .section-view-body {
            padding: 22px 20px;
            color: #334155;
            line-height: 1.8;
            font-size: 15px;
            min-height: 100px;
        }

        .section-content-row {
            display: flex;
            align-items: flex-start;
            gap: 15px;
        }

        .section-content-text {
            flex: 1;
            min-width: 0;
        }

        .section-content-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }
            .section-view-body img {
                max-width: 100%;
                height: auto;
            }

        .section-view-attachment {
            margin-top: 18px;
            padding-top: 14px;
            border-top: 1px solid #eef2f7;
        }

            .section-view-attachment a {
                color: #2563eb;
                text-decoration: none;
            }

                .section-view-attachment a:hover {
                    text-decoration: underline;
                }

        .section-small-title.active-section {
            background: #eaf2ff !important;
            color: #2563eb !important;
        }

            .section-small-title.active-section .type-arrow {
                color: #2563eb !important;
            }
    </style>

</head>


<body>


    <!-- =====================================================
         TOPBAR
    ===================================================== -->

    <div class="topbar">


        <a href="/"
           class="logo">

            E-Learning

        </a>


        <a href="/"
           class="top-link">

            Trang chủ

        </a>


        <a href="/Lesson"
           class="top-link active">

            Chuyên mục

        </a>


        <a asp-controller="Learning"
           asp-action="MyCourses"
           class="top-link">

            Khóa học của tôi

        </a>


        <a asp-controller="Learning"
           asp-action="Results"
           class="top-link">

            Kết quả học tập

        </a>


        <a asp-controller="Learning"
           asp-action="LookupScore"
           class="top-link">

            Tra cứu điểm

        </a>


        <div class="user-area">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="account-dropdown">

                    <!-- NÚT TÀI KHOẢN -->
                    <button type="button"
                            class="account-button"
                            id="accountButton">

                        <span class="account-avatar">
                            @accountLetter
                        </span>

                        <span class="account-name">
                            @accountName
                        </span>

                        <i class="bi bi-chevron-down account-arrow"></i>

                    </button>

                    <!-- MENU SỔ XUỐNG -->
                    <div class="account-menu" id="accountMenu">

                        <!-- HỒ SƠ -->
                        <a asp-controller="Account"
                           asp-action="Profile"
                           class="account-menu-item">
                            <i class="bi bi-person"></i>
                            <span>
                                @(isEn ? "Profile" : "Hồ sơ")
                            </span>
                        </a>

                        <!-- KẾT QUẢ -->
                        <a asp-controller="Learning"
                           asp-action="Results"
                           class="account-menu-item">
                            <i class="bi bi-file-earmark-text"></i>
                            <span>
                                @(isEn ? "My Results" : "Kết quả học tập")
                            </span>
                        </a>

                        <!-- LỊCH -->
                        <a asp-controller="Learning"
                           asp-action="Schedule"
                           class="account-menu-item">
                            <i class="bi bi-calendar3"></i>
                            <span>
                                @(isEn ? "Schedule" : "Lịch học")
                            </span>
                        </a>

                        <!-- TÀI LIỆU -->
                        <a asp-controller="Learning"
                           asp-action="Documents"
                           class="account-menu-item">
                            <i class="bi bi-folder-plus"></i>
                            <span>
                                @(isEn ? "My Documents" : "Tài liệu cá nhân")
                            </span>
                        </a>

                        <!-- BÁO CÁO -->
                        <a asp-controller="Learning"
                           asp-action="Report"
                           class="account-menu-item">
                            <i class="bi bi-file-text"></i>
                            <span>
                                @(isEn ? "Academic Report" : "Báo cáo học tập")
                            </span>
                        </a>

                        <div class="account-divider"></div>

                        <!-- CÀI ĐẶT -->
                        <a asp-controller="Account"
                           asp-action="Settings"
                           class="account-menu-item">
                            <i class="bi bi-sliders"></i>
                            <span>
                                @(isEn ? "Settings" : "Cài đặt")
                            </span>
                        </a>

                        <!-- NGÔN NGỮ -->
                        <div class="account-menu-item language-item">

                            <i class="bi bi-translate"></i>

                            <span class="language-title">
                                @(isEn ? "Language" : "Ngôn ngữ")
                            </span>

                            <span class="language-buttons">

                                <a href="@Url.Action(
                                    "SetLanguage",
                                    "Account",
                                    new
                                    {
                                        lang = "vi",
                                        returnUrl = Context.Request.Path
                                    })"
                                   class="language-btn @(!isEn ? "active" : "inactive")">
                                    VI
                                </a>

                                <a href="@Url.Action(
                                    "SetLanguage",
                                    "Account",
                                    new
                                    {
                                        lang = "en",
                                        returnUrl = Context.Request.Path
                                    })"
                                   class="language-btn @(isEn ? "active" : "inactive")">
                                    EN
                                </a>

                            </span>

                        </div>

                        <div class="account-divider"></div>

                        <!-- ĐĂNG XUẤT -->
                        <a asp-controller="Account"
                           asp-action="Logout"
                           class="account-menu-item logout-item">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>
                                @(isEn ? "Log out" : "Đăng xuất")
                            </span>
                        </a>

                    </div>

                </div>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="account-login-link">
                    @(isEn ? "Account" : "Tài khoản")
                </a>
            }

        </div>

    </div>



    <!-- =====================================================
         MAIN LAYOUT
    ===================================================== -->

    <div class="layout">


        <!-- =================================================
             SIDEBAR
        ================================================= -->

        <aside class="sidebar">


            <div class="sidebar-title">

                Nội dung khóa học

            </div>


            <!-- =================================================
                 LESSON SECTIONS - DỮ LIỆU TỪ DATABASE
            ================================================= -->
            <!-- =================================================
                 NỘI DUNG HỌC PHẦN
            ================================================= -->

            <div class="sidebar-group-title">
                Nội dung học phần
            </div>

            @if (lessonSections.Any())
            {
                var sectionGroups = lessonSections
                .Where(x => !string.IsNullOrWhiteSpace(x.SectionType))
                .GroupBy(x => x.SectionType!.Trim())
                .OrderBy(x => x.Min(y => y.OrderNumber))
                .ToList();

                var sectionsWithoutGroup = lessonSections
                .Where(x => string.IsNullOrWhiteSpace(x.SectionType))
                .OrderBy(x => x.OrderNumber)
                .ThenBy(x => x.Id)
                .ToList();


                <!-- =================================================
                     CÁC NHÓM TIÊU ĐỀ LỚN
                ================================================= -->
                foreach (var group in sectionGroups)
                {
                    var groupId = "section-group-" + group.Key.GetHashCode();

                    var groupItems = group
                    .OrderBy(x => x.OrderNumber)
                    .ThenBy(x => x.Id)
                    .ToList();


                    <div class="chapter">

                        <!-- =================================================
                             TIÊU ĐỀ LỚN
                        ================================================= -->

                        <button type="button"
                                class="chapter-header"
                                data-target="@groupId">

                            <span class="chapter-arrow">
                                ▶
                            </span>

                            <span>
                                @group.Key.ToUpper()
                            </span>

                        </button>


                        <!-- =================================================
                             DANH SÁCH TIÊU ĐỀ NHỎ
                        ================================================= -->

                        <div id="@groupId"
                             class="chapter-content">

                            @foreach (var lessonSection in groupItems)
                            {
                                <div class="lesson-type">

                                   <button type="button"
                                            class="lesson-type-header section-small-title"
                                            data-section-id="@lessonSection.Id"
                                            onclick="showSection(@lessonSection.Id, this)">

                                        <span class="type-arrow"
                                              style="font-size:11px;">
                                            ○
                                        </span>

                                        <span>
                                            @lessonSection.OrderNumber.
                                            @lessonSection.Title
                                        </span>

                                    </button>

                                </div>
                            }

                        </div>

                    </div>
                }


                <!-- =================================================
                     CÁC NỘI DUNG CHƯA CÓ TIÊU ĐỀ LỚN
                ================================================= -->
                @if (sectionsWithoutGroup.Any())
                {
                    <div class="chapter">

                        <button type="button"
                                class="chapter-header"
                                data-target="section-group-other">

                            <span class="chapter-arrow">
                                ▶
                            </span>

                            <span>
                                NỘI DUNG KHÁC
                            </span>

                        </button>


                        <div id="section-group-other"
                             class="chapter-content">

                            @foreach (var lessonSection in sectionsWithoutGroup)
                            {
                                <div class="lesson-type">

                                    <button type="button"
                                            class="lesson-type-header section-small-title"
                                            data-section-id="@lessonSection.Id"
                                            onclick="showSection(@lessonSection.Id, this)">

                                        <span class="type-arrow"
                                              style="font-size:11px;">
                                            ○
                                        </span>

                                        <span>
                                            @lessonSection.OrderNumber.
                                            @lessonSection.Title
                                        </span>

                                    </button>

                                </div>
                            }

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="px-4 py-3 text-muted small">
                    Chưa có nội dung học phần.
                </div>
            }

            <!-- =================================================
                 CHAPTERS
            ================================================= -->

            <div class="sidebar-group-title">

                Nội dung giảng dạy

            </div>


            @if (chapters.Any())
            {

                foreach (var chapter in chapters)
                {

                    var chapterLessons =
                    lessons
                    .Where(x => x.ChapterId == chapter.Id)
                    .OrderBy(x => x.OrderNumber)
                    .ThenBy(x => x.Id)
                    .ToList();

                    var chapterId =
                    "chapter-" + chapter.Id;


                    <div class="chapter">


                        <button type="button"
                                class="chapter-header"
                                data-target="@chapterId">

                            <span class="chapter-arrow">
                                ▶
                            </span>

                            <span>
                                Chương @chapter.OrderNumber -
                                @chapter.Name
                            </span>

                        </button>


                        <div id="@chapterId"
                             class="chapter-content">


                            @if (chapterLessons.Any())
                            {

                                var lessonTypes =
                                chapterLessons
                                .GroupBy(x =>
                                string.IsNullOrWhiteSpace(x.LessonType)
                                ? "Khác"
                                : x.LessonType)
                                .OrderBy(x =>
                                x.Key.Contains("Lý thuyết") ? 0 :
                                x.Key.Contains("Thực hành") ? 1 :
                                x.Key.Contains("Bài tập") ? 2 :
                                x.Key.Contains("Quiz") ? 3 :
                                x.Key.Contains("Thảo luận") ? 4 :
                                5)
                                .ToList();


                                for (
                                int typeIndex = 0;
                                typeIndex < lessonTypes.Count;
                                typeIndex++)
                                {

                                    var lessonType =
                                    lessonTypes[typeIndex];

                                    var typeId =
                                    "type-"
                                    + chapter.Id
                                    + "-"
                                    + typeIndex;

                                    var displayType =
                                    lessonType.Key.Contains("Lý thuyết")
                                    ? "Lý thuyết"
                                    : lessonType.Key.Contains("Thực hành")
                                    ? "Thực hành"
                                    : lessonType.Key;


                                    <div class="lesson-type">


                                        <button type="button"
                                                class="lesson-type-header"
                                                data-target="@typeId">

                                            <span class="type-arrow">
                                                ▶
                                            </span>

                                            <span>
                                                @displayType
                                            </span>

                                        </button>


                                        <div id="@typeId"
                                             class="lesson-type-content">


                                            @foreach (var lesson in lessonType
                                           .OrderBy(x => x.OrderNumber)
                                           .ThenBy(x => x.Id))
                                            {

                                                <button type="button"
                                                        class="lesson-item"
                                                        data-lesson-id="@lesson.Id"
                                                        onclick="showLesson(@lesson.Id, this)">

                                                    <span class="lesson-number">
                                                        @lesson.OrderNumber.
                                                    </span>

                                                    <span>
                                                        @lesson.Title
                                                    </span>

                                                </button>

                                            }


                                        </div>

                                    </div>

                                }

                            }
                            else
                            {

                                <div class="px-4 py-3 text-muted small">

                                    Chưa có bài học trong chương này.

                                </div>

                            }

                        </div>

                    </div>

                }

            }
            else
            {

                <div class="lesson-placeholder">

                    <div class="lesson-placeholder-icon">

                        📚

                    </div>

                    Chưa có chương.

                </div>

            }

        </aside>



        <!-- =================================================
             MAIN
        ================================================= -->

        <main class="main">


            <!-- =================================================
                 COURSE BANNER
            ================================================= -->

            <div class="course-banner">


                @if (!string.IsNullOrWhiteSpace(Model.Image))
                {

                    <img src="@Model.Image"
                         alt="@Model.Title"
                         class="course-banner-image" />

                }
                else
                {

                    <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3"
                         alt="E-Learning"
                         class="course-banner-image" />

                }


                <div class="course-banner-overlay"></div>


                <div class="course-info">


                    <span class="course-label">

                        Khóa học

                    </span>


                    <div class="course-title">

                        @Model.Title

                    </div>


                    <div class="teacher">


                        <div class="teacher-avatar">

                            @teacherLetter

                        </div>


                        <span>

                            @teacherName

                        </span>


                    </div>

                </div>

            </div>



            <!-- =================================================
                 TABS
            ================================================= -->

            <div class="tabs">


                <a href="#course-content"
                   class="tab active">

                    Course

                </a>


                <a href="#participants-content"
                   class="tab">

                    Participants

                </a>


                <a href="#grades-content"
                   class="tab">

                    Grades

                </a>


                <a href="#activities-content"
                   class="tab">

                    Activities

                </a>


                <a href="#competencies-content"
                   class="tab">

                    Competencies

                </a>


                <a href="#more-content"
                   class="tab">

                    ...

                </a>


            </div>



            <!-- =================================================
                 ALERT
            ================================================= -->
            @if (TempData["Success"] != null)
            {

                <div class="alert alert-success page-alert mt-3">

                    <i class="bi bi-check-circle"></i>

                    @TempData["Success"]

                </div>

            }


            @if (TempData["Error"] != null)
            {

                <div class="alert alert-danger page-alert mt-3">

                    <i class="bi bi-exclamation-triangle"></i>

                    @TempData["Error"]

                </div>

            }


            <!-- =================================================
                 TEACHER TOOLBAR
            ================================================= -->
            @if (isCourseTeacher)
            {
                <div class="teacher-toolbar">

                    <div class="teacher-toolbar-title">
                        <i class="bi bi-person-workspace"></i>
                        Chức năng giảng viên
                    </div>

                    <div class="teacher-toolbar-buttons">

                        <!-- =========================================
                             THÊM NỘI DUNG HỌC PHẦN
                        ========================================== -->
                        <button type="button"
                                class="teacher-btn teacher-btn-info"
                                data-bs-toggle="modal"
                                data-bs-target="#createSectionModal">

                            <i class="bi bi-file-plus"></i>
                            Thêm nội dung

                        </button>


                        <!-- =========================================
                             THÊM CHƯƠNG
                        ========================================== -->
                        <button type="button"
                                class="teacher-btn teacher-btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#createChapterModal">

                            <i class="bi bi-folder-plus"></i>
                            Thêm chương

                        </button>

                    </div>

                </div>
            }



            <!-- =================================================
                 CONTENT
            ================================================= -->
            <!-- =================================================
                 CONTENT
            ================================================= -->

            <div class="content">

                <div id="course-content"
                     class="tab-content-box">
                    <div id="sectionView"
                         class="section-view"
                         style="display:none;">

                        <div class="section-view-header">

                            <div>

                                <div class="section-view-title"
                                     id="sectionViewTitle">
                                </div>

                            </div>

                            @if (isCourseTeacher)
                            {
                                <div class="section-view-actions"
                                     id="sectionViewActions"
                                     style="display:none;">

                                    <!-- SỬA -->
                                    <button type="button"
