                                                    <button type="submit"
                                                            class="btn btn-primary">

                                                        <i class="bi bi-save"></i>

                                                        Lưu thay đổi

                                                    </button>

                                                </div>

                                            </form>

                                        </div>

                                    </div>

                                </div>
                            }

                        }
                    }
                    else
                    {
                        <div class="empty">

                            <i class="bi bi-file-earmark-text"
                               style="font-size:45px;">
                            </i>

                            <h4 class="mt-3">
                                Chưa có nội dung học phần
                            </h4>

                            <p>
                                Giảng viên chưa tạo nội dung cho học phần này.
                            </p>

                        </div>
