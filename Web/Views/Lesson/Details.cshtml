                                                     tabindex="-1"
                                                     aria-hidden="true">

                                                    <div class="modal-dialog modal-lg modal-dialog-centered">

                                                        <div class="modal-content">

                                                            <div class="modal-header">

                                                                <div>

                                                                    <h5 class="modal-title">
                                                                        <i class="bi bi-pencil-square"></i>
                                                                        Sửa bài giảng
                                                                    </h5>

                                                                    <small class="text-muted">
                                                                        @lesson.Title
                                                                    </small>

                                                                </div>

                                                                <button type="button"
                                                                        class="btn-close"
                                                                        data-bs-dismiss="modal">
                                                                </button>

                                                            </div>


