                                                                                    <option value="Lecture / Lý thuyết" selected>
                                                                                        Lecture / Lý thuyết
                                                                                    </option>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <option value="Lecture / Lý thuyết">
                                                                                        Lecture / Lý thuyết
                                                                                    </option>
                                                                                }


                                                                                @if (lesson.LessonType == "Thực hành")
                                                                                {
                                                                                    <option value="Thực hành" selected>
                                                                                        Thực hành
                                                                                    </option>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <option value="Thực hành">
                                                                                        Thực hành
                                                                                    </option>
                                                                                }


                                                                                @if (lesson.LessonType == "Bài tập")
                                                                                {
                                                                                    <option value="Bài tập" selected>
                                                                                        Bài tập
                                                                                    </option>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <option value="Bài tập">
                                                                                        Bài tập
                                                                                    </option>
                                                                                }


                                                                                @if (lesson.LessonType == "Kiểm tra")
                                                                                {
                                                                                    <option value="Kiểm tra" selected>
                                                                                        Kiểm tra
                                                                                    </option>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <option value="Kiểm tra">
                                                                                        Kiểm tra
                                                                                    </option>
                                                                                }

                                                                            </select>
                                                                            <!-- =====================================================
                                                                                 THÔNG TIN BÀI TẬP KHI SỬA
                                                                            ====================================================== -->

                                                                            <div id="editAssignmentFields-@lesson.Id"
