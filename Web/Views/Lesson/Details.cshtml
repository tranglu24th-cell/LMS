                                                  asp-action="DeleteChapter"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa chương này không?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@chapter.Id" />

                                                <button type="submit"
                                                        class="hover-action-btn hover-delete"
                                                        title="Xóa chương">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </form>

                                        </div>
                                    }

                                    @if (isCourseTeacher)
                                    {
                                        <div style="padding:12px 20px;background:#fff;border-bottom:1px solid #e5e7eb;">
                                            <button type="button"
                                                    class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#createActivityModal-@chapter.Id">
                                                <i class="bi bi-plus-lg"></i>
                                                Thêm hoạt động
                                            </button>
                                        </div>
                                    }
