                                                                  rows="10"
                                                                  placeholder="Nhập nội dung chi tiết...">@lessonSection.Content</textarea>

                                                    </div>

                                                    <div class="mb-3">

                                                        <label class="form-label fw-bold">
                                                            Thứ tự
                                                        </label>

                                                        <input type="number"
                                                               name="orderNumber"
                                                               class="form-control"
                                                               min="1"
                                                               value="@lessonSection.OrderNumber"
                                                               required />

                                                    </div>


                                                    @if (!string.IsNullOrWhiteSpace(
                                                   lessonSection.AttachmentFileName))
                                                    {
                                                        <div class="mb-3">

                                                            <label class="form-label fw-bold">
                                                                Tài liệu hiện tại
                                                            </label>

                                                            <div class="alert alert-light border">

                                                                <i class="bi bi-paperclip"></i>

                                                                @lessonSection.AttachmentFileName

                                                                @if (!string.IsNullOrWhiteSpace(
                                                               lessonSection.AttachmentPath))
                                                                {
                                                                    <a href="@lessonSection.AttachmentPath"
                                                                       target="_blank"
                                                                       class="ms-2">
                                                                        Mở file
                                                                    </a>
                                                                }

                                                            </div>

                                                            <div class="form-check">

                                                                <input type="checkbox"
                                                                       class="form-check-input"
