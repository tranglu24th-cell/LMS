                                                              asp-action="DeleteLesson"
                                                              method="post"
                                                              class="d-inline"
                                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài giảng này không?');">

                                                            @Html.AntiForgeryToken()

                                                            <input type="hidden"
                                                                   name="id"
                                                                   value="@lesson.Id" />

                                                            <button type="submit"
                                                                    class="hover-action-btn hover-delete"
                                                                    title="Xóa bài giảng">

                                                                <i class="bi bi-trash"></i>

                                                            </button>

                                                        </form>

                                                    </div>
                                                }

                                            </div>


                                            <!-- =====================================================
                                                 MODAL SỬA BÀI GIẢNG
                                            ====================================================== -->
