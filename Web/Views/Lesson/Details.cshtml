    <script>


        /* =====================================================
           CHAPTER
        ===================================================== */

        document
            .querySelectorAll(".chapter-header")
            .forEach(function (button) {

                button.addEventListener("click", function () {

                    var targetId =
                        this.getAttribute("data-target");

                    var target =
                        document.getElementById(targetId);

                    var arrow =
                        this.querySelector(".chapter-arrow");


                    if (!target) {
                        return;
                    }


                    var opened =
                        target.classList.contains("show");


                    if (opened) {

                        target.classList.remove("show");

                        if (arrow) {
                            arrow.textContent = "▶";
                        }

                    }
                    else {

                        target.classList.add("show");

                        if (arrow) {
                            arrow.textContent = "▼";
                        }

                    }

                });

            });



        /* =====================================================
           LESSON TYPE
        ===================================================== */
        document
            .querySelectorAll(
                ".lesson-type-header:not(.section-small-title)"
            )
            .forEach(function (button) {

                button.addEventListener("click", function () {

                    var targetId =
                        this.getAttribute("data-target");

                    var target =
                        document.getElementById(targetId);

                    var arrow =
                        this.querySelector(".type-arrow");


                    if (!target) {
                        return;
                    }


                    var opened =
                        target.classList.contains("show");


                    if (opened) {

                        target.classList.remove("show");

                        if (arrow) {
                            arrow.textContent = "▶";
                        }

                    }
                    else {

                        target.classList.add("show");

                        if (arrow) {
                            arrow.textContent = "▼";
                        }

                    }

                });

            });



