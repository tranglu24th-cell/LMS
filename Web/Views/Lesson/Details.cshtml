                                        int stt = 1;
                                    }

                                    @foreach (var enrollment in Model.Enrollments)
                                    {
                                        var student =
                                        enrollment.Student;

                                        if (student == null)
                                        {
                                            continue;
                                        }

                                        <tr class="participant-row"
                                            data-status="@(student.IsActive ? "active" : "locked")">

                                            <td>
                                                @stt
