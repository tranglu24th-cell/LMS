            var lessonEditButton =
                document.getElementById(
                    "lessonEditButton"
                );

            var lessonDeleteId =
                document.getElementById(
                    "lessonDeleteId"
                );


            /* =====================================================
               THÔNG TIN ASSIGNMENT
            ===================================================== */

            var assignmentInfo =
                document.getElementById(
                    "lesson-assignment-info"
                );

            var assignmentDue =
                document.getElementById(
                    "lesson-assignment-due"
                );

            var assignmentScore =
                document.getElementById(
                    "lesson-assignment-score"
                );


            /* =====================================================
               KIỂM TRA
            ===================================================== */

            if (!lessonData || !lessonView) {
                return;
            }


            /* =====================================================
               LẤY DỮ LIỆU BÀI
            ===================================================== */

            var title =
                lessonData.getAttribute(
                    "data-title"
                ) || "";


            var order =
                lessonData.getAttribute(
                    "data-order"
                ) || "";


                   var lessonType =
            lessonData.getAttribute(
                "data-lesson-type"
            ) || "";

        var attachmentName =
            lessonData.getAttribute(
                "data-attachment-name"
            ) || "";

        var attachmentPath =
            lessonData.getAttribute(
                "data-attachment-path"
            ) || "";

        var dueDate =
            lessonData.getAttribute(
                "data-due-date"
            ) || "";

        var maxScore =
            lessonData.getAttribute(
                "data-max-score"
            ) || "";

            /* =====================================================
               TIÊU ĐỀ
            ===================================================== */

            if (orderElement) {

                orderElement.textContent =
                    "Bài " + order;

            }


            if (titleElement) {

                titleElement.textContent =
                    title;

            }


            /* =====================================================
               NỘI DUNG
            ===================================================== */

            if (bodyElement) {

                bodyElement.innerHTML =
                    lessonData.innerHTML;

            }


            /* =====================================================
               FILE ĐÍNH KÈM
            ===================================================== */

            if (
                attachmentArea &&
                attachmentNameElement &&
                attachmentLink
            ) {

                if (
                    attachmentName !== "" &&
                    attachmentPath !== ""
                ) {

                    attachmentArea.style.display =
                        "block";

                    attachmentNameElement.textContent =
                        attachmentName;

                    attachmentLink.href =
                        attachmentPath;

                }
                else {

                    attachmentArea.style.display =
                        "none";

                    attachmentNameElement.textContent =
                        "";

                    attachmentLink.href =
                        "#";

                }

            }

        /* =====================================================
           THÔNG TIN BÀI TẬP
        ===================================================== */

        if (assignmentInfo) {

            var normalizedLessonType =
                lessonType
                    .trim()
                    .toLowerCase();


            if (
                normalizedLessonType ===
                "bài tập"
            ) {

                assignmentInfo.style.display =
                    "block";


                /* ---------------------------------------------
                   HẠN NỘP
                --------------------------------------------- */

                if (assignmentDue) {

                    if (dueDate !== "") {

                        var due =
                            new Date(dueDate);


                        if (!isNaN(due.getTime())) {

                            assignmentDue.textContent =
                                due.toLocaleString(
                                    "vi-VN"
                                );

                        }
                        else {

                            assignmentDue.textContent =
                                "Chưa xác định";

                        }

                    }
                    else {

                        assignmentDue.textContent =
                            "Không có hạn nộp";

                    }

                }


                /* ---------------------------------------------
                   ĐIỂM TỐI ĐA
                --------------------------------------------- */

                if (assignmentScore) {

                    assignmentScore.textContent =
                        maxScore !== ""
                            ? maxScore
                            : "0";

                }

            }
            else {

                assignmentInfo.style.display =
                    "none";

            }

        }


            /* =====================================================
               QUYỀN GIẢNG VIÊN
            ===================================================== */

            if (lessonViewActions) {

                lessonViewActions.style.display =
                    "flex";

            }


            /* =====================================================
               NÚT SỬA

               Không dùng href EditLesson nữa vì
               GET EditLesson đã được xóa.

               Sử dụng modal:
               #editLessonModal-{id}
            ===================================================== */

            if (lessonEditButton) {

                lessonEditButton.setAttribute(
                    "data-bs-toggle",
                    "modal"
                );

                lessonEditButton.setAttribute(
                    "data-bs-target",
                    "#editLessonModal-" + id
                );

                lessonEditButton.removeAttribute(
                    "href"
                );

            }


            /* =====================================================
               NÚT XÓA
            ===================================================== */

            if (lessonDeleteId) {

                lessonDeleteId.value =
                    id;

            }


            /* =====================================================
               HIỆN KHUNG CHI TIẾT
            ===================================================== */

            lessonView.style.display =
                "block";


            /* =====================================================
               ACTIVE SIDEBAR
            ===================================================== */

            document
                .querySelectorAll(
                    ".sidebar .lesson-item"
                )
                .forEach(function (item) {

                    item.classList.remove(
                        "active"
                    );

                });


            if (button) {

                button.classList.add(
                    "active"
                );

            }


            /* =====================================================
               CUỘN ĐẾN KHUNG CHI TIẾT
            ===================================================== */

            lessonView.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });

        }

                /* =====================================================
           HIỂN THỊ NỘI DUNG HỌC PHẦN
        ===================================================== */

                        function showSection(id, button) {

            var sectionData =
                document.getElementById(
                    "section-data-" + id
                );

            var sectionView =
                document.getElementById(
                    "sectionView"
                );

            var titleElement =
                document.getElementById(
                    "sectionViewTitle"
                );

            var typeElement =
                document.getElementById(
                    "sectionViewType"
                );

            var bodyElement =
                document.getElementById(
                    "sectionViewBody"
                );


            /* NÚT SỬA/XÓA Ở PHẦN NỘI DUNG */

            var contentEditButton =
                document.getElementById(
                    "sectionContentEditButton"
                );

            var contentDeleteId =
                document.getElementById(
                    "sectionContentDeleteId"
                );


            /* NÚT SỬA/XÓA Ở TIÊU ĐỀ */

            var editButton =
                document.getElementById(
                    "sectionEditButton"
                );

            var deleteId =
                document.getElementById(
                    "sectionDeleteId"
                );


            if (
                !sectionData ||
                !sectionView ||
                !titleElement ||
                !typeElement ||
                !bodyElement
            ) {

                console.error(
                    "Không tìm thấy LessonSection: " + id
                );

                return;
            }


            var title =
                sectionData.getAttribute(
                    "data-title"
                ) || "";


            var type =
                sectionData.getAttribute(
                    "data-type"
                ) || "";


            var attachmentName =
                sectionData.getAttribute(
                    "data-attachment-name"
                ) || "";


            var attachmentPath =
                sectionData.getAttribute(
                    "data-attachment-path"
                ) || "";


            var editModal =
                sectionData.getAttribute(
                    "data-edit-modal"
                ) || "";


            /* =====================================
               TIÊU ĐỀ
            ===================================== */

            titleElement.textContent =
                "📄 " + title;


            /* =====================================
               LOẠI
            ===================================== */

            typeElement.textContent =
                type !== ""
                    ? type
                    : "Nội dung học phần";


            /* =====================================
               NỘI DUNG
            ===================================== */

            bodyElement.innerHTML =
                sectionData.innerHTML;


            /* =====================================
               FILE
            ===================================== */

            if (
                attachmentName !== "" &&
                attachmentPath !== ""
            ) {

                var fileHtml =
                    document.createElement("div");

                fileHtml.className =
                    "section-view-attachment";

                fileHtml.innerHTML =
                    '<i class="bi bi-paperclip"></i> ' +
                    '<a href="' +
                    attachmentPath +
                    '" target="_blank">' +
                    attachmentName +
                    '</a>';

                bodyElement.appendChild(
                    fileHtml
                );
            }


            /* =====================================
               NÚT SỬA Ở TIÊU ĐỀ
            ===================================== */

            if (
                editButton &&
                editModal !== ""
            ) {

                editButton.setAttribute(
                    "data-bs-toggle",
                    "modal"
                );

                editButton.setAttribute(
                    "data-bs-target",
                    "#" + editModal
                );
            }


            /* =====================================
               ID XÓA SECTION
            ===================================== */

            if (deleteId) {

                deleteId.value =
                    id;
            }


            /* =====================================
               NÚT SỬA Ở PHẦN NỘI DUNG
            ===================================== */

            if (
                contentEditButton &&
                editModal !== ""
            ) {

                contentEditButton.setAttribute(
                    "data-bs-toggle",
                    "modal"
                );

                contentEditButton.setAttribute(
                    "data-bs-target",
                    "#" + editModal
                );
            }


            /* =====================================
               ID XÓA RIÊNG CONTENT
            ===================================== */

            if (contentDeleteId) {

                contentDeleteId.value =
                    id;
            }


            /* =====================================
               HIỆN SECTION
            ===================================== */

            sectionView.style.display =
                "block";


            /* =====================================
               ACTIVE SIDEBAR
            ===================================== */

            document
                .querySelectorAll(
                    ".sidebar .section-small-title"
                )
                .forEach(function (item) {

                    item.classList.remove(
                        "active-section"
                    );

                });


            if (button) {

                button.classList.add(
                    "active-section"
                );

            }


            sectionView.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });

        }

        /* =====================================================
           TABS
        ===================================================== */

        document
            .querySelectorAll(".tab")
            .forEach(function (tab) {

                tab.addEventListener("click", function (event) {

                    event.preventDefault();


                    document
                        .querySelectorAll(".tab")
                        .forEach(function (item) {

                            item.classList.remove("active");

                        });


                    this.classList.add("active");


                    document
                        .querySelectorAll(".tab-content-box")
                        .forEach(function (content) {

                            content.style.display =
                                "none";

                        });


                    var targetId =
                        this.getAttribute("href");


                    var target =
                        document.querySelector(targetId);


                    if (target) {

                        target.style.display =
                            "block";

                    }

                });

            });



        /* =====================================================
           PARTICIPANT FILTER
        ===================================================== */

        var participantFilter =
            document.getElementById(
                "participantFilter"
            );


        if (participantFilter) {

            participantFilter.addEventListener(
                "change",
                function () {

                    var selected =
                        this.value;


                    document
                        .querySelectorAll(
                            ".participant-row"
                        )
                        .forEach(function (row) {


                            var status =
                                row.getAttribute(
                                    "data-status"
                                );


                            if (
                                selected === "all"
                                ||
                                selected === status
                            ) {

                                row.style.display =
                                    "";

                            }
                            else {

                                row.style.display =
                                    "none";

                            }

                        });

                }
            );

        }


    </script>


    <!-- =====================================================
         ACCOUNT MENU JAVASCRIPT
    ===================================================== -->

    <script>

        const accountButton =
            document.getElementById("accountButton");

        const accountMenu =
            document.getElementById("accountMenu");


        if (accountButton && accountMenu) {

            accountButton.addEventListener(
                "click",
                function (event) {

                    event.stopPropagation();

                    accountMenu.classList.toggle("show");

                }
            );


            document.addEventListener(
                "click",
                function () {

                    accountMenu.classList.remove("show");

                }
            );

        }

    </script>
    <script>
        function toggleSectionContent(id) {

            const element = document.getElementById(id);

            if (!element) {
                return;
            }

            const isHidden =
                element.style.display === "none" ||
                element.style.display === "";

            element.style.display =
                isHidden ? "block" : "none";
        }
    </script>

    <!-- =====================================================
         AI TUTOR
    ===================================================== -->
    @if (ViewBag.CurrentUserId != null)
    {
        var tutorCtx = new ChatWidgetModel
                {
                    CourseId = Model.Id,
                    ContextLabel = "Đang hỗ trợ khóa: " + Model.Title
                };

        @await Html.PartialAsync(
                "_AiTutorWidget",
                tutorCtx
                )
    }
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            document
                .querySelectorAll('[id^="editLessonType-"]')
                .forEach(function (select) {

                    var lessonId =
                        select.id.replace(
                            "editLessonType-",
                            ""
                        );

                    var assignmentFields =
                        document.getElementById(
                            "editAssignmentFields-" + lessonId
                        );

                    if (!assignmentFields) {
                        return;
                    }

                    function toggleEditAssignment() {

                        var value =
                            select.value
                                .trim()
                                .toLowerCase();

                        if (value === "bài tập") {

                            assignmentFields.style.display =
                                "block";

                        }
                        else {

                            assignmentFields.style.display =
                                "none";

                        }
                    }

                    select.addEventListener(
                        "change",
                        toggleEditAssignment
                    );

                    toggleEditAssignment();

                });

        });
    </script>
    <script>

        document.addEventListener("submit", async function (event) {

            var form = event.target;

            if (!form.id || !form.id.startsWith("quizForm-")) {
                return;
            }

            event.preventDefault();

            var lessonId =
                form.id.replace("quizForm-", "");

            var resultBox =
                document.getElementById(
                    "quizResult-" + lessonId
                );

            try {

                var formData =
                    new FormData(form);

                var response =
                    await fetch(
                        form.action,
                        {
                            method: "POST",
                            body: formData
                        }
                    );

                if (!response.ok) {

                    throw new Error(
                        "Không thể nộp bài."
                    );

                }

                var data =
                    await response.json();

                if (!data.success) {

                    throw new Error(
                        "Nộp bài thất bại."
                    );

                }

                var html = "";

                html += `
                    <div class="alert alert-info">
                        <div class="fw-bold fs-5">
                            Kết quả: ${data.score} / ${data.maxScore}
                        </div>
                    </div>
                `;


                data.results.forEach(function (item) {

                    html += `
                        <div class="quiz-question-card">
                            <div class="fw-bold mb-2">
                                Câu ${item.questionOrder}
                            </div>

                            <div class="mb-3">
                                ${item.questionText}
                            </div>
                    `;

                    if (item.isCorrect) {

                        html += `
                            <div class="alert alert-success mb-2">
                                <strong>Đúng ✅</strong>
                            </div>
                        `;

                    }
                    else {

                        html += `
                            <div class="alert alert-danger mb-2">
                                <strong>Sai ❌</strong>
                            </div>
                        `;

                    }

                    html += `
                        <div>
                            <strong>Đáp án của bạn:</strong>
                            ${item.selectedText ?? "Chưa chọn"}
                        </div>

                        <div class="mt-1">
                            <strong>Đáp án đúng:</strong>
                            ${item.correctText ?? "Chưa có"}
                        </div>

                        </div>
                    `;

                });


                resultBox.innerHTML = html;

                resultBox.style.display = "block";

                resultBox.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });


                form.querySelectorAll(
                    "input[type='radio']"
                ).forEach(function (input) {
                    input.disabled = true;
                });


                var submitButton =
                    form.querySelector(
                        "button[type='submit']"
                    );

                if (submitButton) {
                    submitButton.disabled = true;
                }

            }
            catch (error) {

                alert(error.message);

            }

        });

    </script>

