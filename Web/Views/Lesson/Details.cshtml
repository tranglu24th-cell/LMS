                    <!-- =====================================================
                         NỘI DUNG GIẢNG DẠY
                    ====================================================== -->

                    <div style="margin-top:35px;margin-bottom:15px;">

                        <h2 style="
                font-size:22px;
                font-weight:700;
                color:#1e293b;
                margin:0;
            ">
                            📚 Nội dung giảng dạy
                        </h2>

                        <p style="
                margin-top:6px;
                color:#64748b;
            ">
                            Các chương và bài giảng của khóa học.
                        </p>

                    </div>


                    @if (chapters.Any())
                    {
                        foreach (var chapter in chapters)
                        {
                            var chapterLessons =
                            lessons
                            .Where(x => x.ChapterId == chapter.Id)
                            .OrderBy(x => x.OrderNumber)
                            .ThenBy(x => x.Id)
                            .ToList();


                            var mainTypes =
                            chapterLessons
                            .GroupBy(x =>
                            string.IsNullOrWhiteSpace(x.LessonType)
                            ? "Khác"
                            : x.LessonType)
                            .OrderBy(x =>
                            x.Key.Contains("Lý thuyết") ? 0 :
                            x.Key.Contains("Thực hành") ? 1 :
                            x.Key.Contains("Bài tập") ? 2 :
                            x.Key.Contains("Quiz") ? 3 :
                            x.Key.Contains("Thảo luận") ? 4 :
                            5)
                            .ToList();


                            <div class="main-chapter">

                                <div class="main-chapter-title">

                                    <div class="chapter-title-text">

                                        <span>
                                            Chương @chapter.OrderNumber
