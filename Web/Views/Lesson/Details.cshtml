                                                                            </label>

                                                                            <div class="alert alert-light border">

                                                                                <i class="bi bi-paperclip"></i>

                                                                                @lesson.AttachmentFileName

                                                                                <a href="@lesson.AttachmentPath"
                                                                                   target="_blank"
                                                                                   class="ms-2">
                                                                                    Mở file
                                                                                </a>

                                                                            </div>


                                                                            <div class="form-check">

                                                                                <input type="checkbox"
                                                                                       class="form-check-input"
                                                                                       name="removeAttachment"
                                                                                       value="true"
                                                                                       id="removeLessonFile-@lesson.Id" />

                                                                                <label class="form-check-label"
                                                                                       for="removeLessonFile-@lesson.Id">

                                                                                    Xóa file hiện tại

                                                                                </label>

                                                                            </div>

                                                                        </div>
                                                                    }


                                                                    <!-- FILE MỚI -->
                                                                    <div class="mb-3">

                                                                        <label class="form-label fw-bold">
                                                                            Tải file mới
                                                                        </label>

                                                                        <input type="file"
                                                                               name="attachment"
                                                                               class="form-control"
                                                                               accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.zip,.rar,.jpg,.jpeg,.png" />

                                                                        <div class="form-text">
                                                                            Tối đa 20MB.
                                                                        </div>

                                                                    </div>

                                                                </div>


                                                                <div class="modal-footer">

                                                                    <button type="button"
                                                                            class="btn btn-secondary"
                                                                            data-bs-dismiss="modal">

                                                                        Hủy

                                                                    </button>

                                                                    <button type="submit"
                                                                            class="btn btn-primary">

                                                                        <i class="bi bi-save"></i>

                                                                        Lưu thay đổi

                                                                    </button>

                                                                </div>

                                                            </form>

                                                        </div>

                                                    </div>

                                                </div>
                                            }
                                        }
                                    }
                                }
                                else
                                {
                                    <div class="p-4 text-muted">
                                        Chưa có bài giảng trong chương này.
                                    </div>
                                }

                            </div>


                            <!-- =================================================
                                 EDIT CHAPTER MODAL
                            ================================================== -->
                            @if (isCourseTeacher)
                            {
                                <div class="modal fade"
                                     id="editChapterModal-@chapter.Id"
                                     tabindex="-1"
                                     aria-hidden="true">

                                    <div class="modal-dialog modal-dialog-centered">

                                        <div class="modal-content">

                                            <div class="modal-header">

                                                <h5 class="modal-title">

                                                    <i class="bi bi-pencil-square"></i>

                                                    Sửa chương

                                                </h5>

                                                <button type="button"
                                                        class="btn-close"
                                                        data-bs-dismiss="modal">
                                                </button>

                                            </div>


                                            <form asp-controller="Lesson"
                                                  asp-action="EditChapter"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <div class="modal-body">

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@chapter.Id" />


                                                    <div class="mb-3">

                                                        <label class="form-label fw-bold">
                                                            Tên chương
                                                        </label>

                                                        <input type="text"
                                                               name="name"
                                                               class="form-control"
                                                               maxlength="200"
                                                               value="@chapter.Name"
                                                               required />

                                                    </div>


                                                    <div class="mb-3">

                                                        <label class="form-label fw-bold">
                                                            Thứ tự chương
                                                        </label>

                                                        <input type="number"
                                                               name="orderNumber"
                                                               class="form-control"
                                                               min="1"
                                                               value="@chapter.OrderNumber"
                                                               required />

                                                    </div>

                                                </div>


                                                <div class="modal-footer">

                                                    <button type="button"
                                                            class="btn btn-secondary"
                                                            data-bs-dismiss="modal">

                                                        Hủy

                                                    </button>

                                                    <button type="submit"
                                                            class="btn btn-primary">

                                                        Lưu thay đổi

                                                    </button>

                                                </div>

                                            </form>

                                        </div>

                                    </div>

                                </div>
                            }

                            <!-- =====================================================
                                 MODAL THÊM HOẠT ĐỘNG
                            ====================================================== -->
                            @if (isCourseTeacher)
                            {
                                <div class="modal fade"
                                     id="createActivityModal-@chapter.Id"
                                     tabindex="-1"
                                     aria-hidden="true">

                                    <div class="modal-dialog modal-lg modal-dialog-centered">

                                        <div class="modal-content">

                                            <div class="modal-header">

                                                <div>

                                                    <h5 class="modal-title">

                                                        <i class="bi bi-plus-circle"></i>

                                                        Thêm hoạt động học tập

                                                    </h5>

                                                    <small class="text-muted">

                                                        Chương @chapter.OrderNumber -
                                                        @chapter.Name

                                                    </small>

                                                </div>


                                                <button type="button"
                                                        class="btn-close"
                                                        data-bs-dismiss="modal">
                                                </button>

                                            </div>


                                            <form asp-controller="Lesson"
                                                  asp-action="CreateLesson"
                                                  method="post"
                                                  enctype="multipart/form-data">

                                                @Html.AntiForgeryToken()


                                                <div class="modal-body">

                                                    <!-- KHÓA HỌC -->
                                                    <input type="hidden"
                                                           name="courseId"
                                                           value="@Model.Id" />


                                                    <!-- CHƯƠNG -->
                                                    <input type="hidden"
                                                           name="chapterId"
                                                           value="@chapter.Id" />


                                                    <!-- TÊN HOẠT ĐỘNG -->
                                                    <div class="mb-3">

                                                        <label class="form-label fw-bold">
                                                            Tên hoạt động
                                                        </label>

                                                        <input type="text"
                                                               name="title"
                                                               class="form-control"
                                                               maxlength="200"
                                                               placeholder="Ví dụ: Bài 1 - Giới thiệu ASP.NET Core"
                                                               required />

                                                    </div>


                                                    <!-- LOẠI HOẠT ĐỘNG -->
                                                    <div class="mb-3">

                                                        <label class="form-label fw-bold">
                                                            Loại hoạt động
                                                        </label>

                                                        <input type="text"
                                                               name="lessonType"
                                                               id="lessonType-@chapter.Id"
                                                               class="form-control"
                                                               list="activityTypeList-@chapter.Id"
                                                               placeholder="Chọn hoặc tự nhập loại hoạt động"
                                                               required />

                                                        <datalist id="activityTypeList-@chapter.Id">
                                                            <option value="Lý thuyết"></option>
                                                            <option value="Thực hành"></option>
                                                            <option value="Bài tập"></option>
                                                            <option value="Quiz / Kiểm tra"></option>
                                                            <option value="Thảo luận"></option>
                                                            <option value="Đồ án"></option>
                                                            <option value="Assignment"></option>
                                                        </datalist>

                                                        <div class="form-text">

                                                            Bạn có thể chọn loại có sẵn hoặc tự nhập loại mới.

                                                        </div>

                                                    </div>
                                                    <!-- =====================================================
                                                         THÔNG TIN BÀI TẬP
                                                    ====================================================== -->

                                                    <div id="assignmentFields-@chapter.Id"
                                                         style="display:none;">

                                                        <div class="alert alert-info">
                                                            <i class="bi bi-info-circle"></i>
                                                            Hoạt động này là bài tập. Vui lòng nhập hạn nộp và điểm tối đa.
                                                        </div>

                                                        <!-- HẠN NỘP -->
                                                        <div class="mb-3">

                                                            <label class="form-label fw-bold">
                                                                Hạn nộp
                                                            </label>

                                                            <input type="datetime-local"
                                                                   name="dueDate"
                                                                   class="form-control" />

                                                        </div>


                                                        <!-- ĐIỂM TỐI ĐA -->
                                                        <div class="mb-3">

                                                            <label class="form-label fw-bold">
                                                                Điểm tối đa
                                                            </label>

                                                            <input type="number"
                                                                   name="maxScore"
                                                                   class="form-control"
                                                                   min="0"
                                                                   max="100"
                                                                   step="0.01"
                                                                   value="10" />

                                                        </div>

                                                    </div>
                                                    <!-- =====================================================
                                                         THÔNG TIN QUIZ
                                                    ====================================================== -->

                                                    <div id="quizFields-@chapter.Id"
                                                         style="display:none;">

                                                        <div class="alert alert-info">
                                                            <i class="bi bi-question-circle"></i>
                                                            Sau khi tạo Quiz, bạn có thể thêm câu hỏi và các đáp án cho Quiz.
                                                        </div>

                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold">
                                                                Thời gian làm bài
                                                            </label>

                                                            <input type="number"
                                                                   name="timeLimitMinutes"
                                                                   class="form-control"
                                                                   min="1"
                                                                   value="30" />

                                                            <div class="form-text">
                                                                Đơn vị: phút
                                                            </div>
                                                        </div>

                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold">
                                                                Điểm tối đa
                                                            </label>

                                                            <input type="number"
                                                                   name="quizMaxScore"
                                                                   class="form-control"
                                                                   min="0"
                                                                   max="100"
                                                                   step="0.01"
                                                                   value="10" />
                                                        </div>

                                                    </div>
                                                    <!-- THỨ TỰ -->
                                                    <div class="mb-3">

                                                        <label class="form-label fw-bold">
                                                            Thứ tự
                                                        </label>

                                                        <input type="number"
                                                               name="orderNumber"
                                                               class="form-control"
                                                               min="1"
                                                               value="@(chapterLessons.Count + 1)"
                                                               required />

                                                    </div>


                                                    <!-- NỘI DUNG -->
                                                    <div class="mb-3">

                                                        <label class="form-label fw-bold">
                                                            Nội dung
                                                        </label>

                                                        <textarea name="content"
                                                                  class="form-control"
                                                                  rows="10"
                                                                  placeholder="Nhập nội dung hoạt động..."></textarea>

                                                    </div>


                                                    <!-- FILE -->
                                                    <div class="mb-3">

                                                        <label class="form-label fw-bold">
                                                            Tài liệu đính kèm
                                                        </label>

                                                        <input type="file"
                                                               name="attachment"
                                                               class="form-control"
                                                               accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.zip,.rar,.jpg,.jpeg,.png" />

                                                        <div class="form-text">

                                                            Tối đa 20MB.

                                                        </div>

                                                    </div>

                                                </div>


                                                <div class="modal-footer">

                                                    <button type="button"
                                                            class="btn btn-secondary"
                                                            data-bs-dismiss="modal">

                                                        Hủy

                                                    </button>


                                                    <button type="submit"
                                                            class="btn btn-primary">

                                                        <i class="bi bi-save"></i>

                                                        Tạo hoạt động

                                                    </button>

                                                </div>

                                            </form>

                                        </div>

                                    </div>

                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="empty">
                            Chưa có chương trong nội dung giảng dạy.
                        </div>
                    }


                    <!-- =====================================================
                         LESSON VIEW
                    ====================================================== -->
                    @if (lessons.Any())
                    {
                        <div class="lesson-view"
                             id="lessonView"
                             style="display:none;">

                            <!-- =================================================
                                 HEADER
                            ================================================= -->

                            <div class="lesson-view-header">

                                <div>

                                    <div class="lesson-view-order"
                                         id="lesson-view-order">

                                        Chưa chọn bài

                                    </div>

                                    <div class="lesson-view-title"
                                         id="lesson-view-title">

                                        Chọn bài học ở bên trái

                                    </div>

                                </div>


                                <!-- =================================================
                                     NÚT SỬA / XÓA CHO GIẢNG VIÊN
                                ================================================= -->
                                @if (isCourseTeacher)
                                {
                                    <div class="lesson-view-actions"
                                         id="lessonViewActions"
                                         style="display:none;">

                                        <!-- SỬA -->
                                        <button type="button"
                                                id="lessonEditButton"
                                                class="hover-action-btn hover-edit"
                                                title="Sửa bài giảng">

                                            <i class="bi bi-pencil"></i>

                                        </button>


                                        <!-- XÓA -->

                                        <form id="lessonDeleteForm"
                                              asp-controller="Lesson"
                                              asp-action="DeleteLesson"
                                              method="post"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài giảng này không?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   id="lessonDeleteId"
                                                   name="id"
                                                   value="" />

                                            <button type="submit"
                                                    class="hover-action-btn hover-delete"
                                                    title="Xóa bài giảng">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>

                                    </div>
                                }

                            </div>


                            <!-- =================================================
                                 NỘI DUNG BÀI
                            ================================================= -->

                            <div class="lesson-view-body"
                                 id="lesson-view-body">

                                <div class="lesson-placeholder">

                                    <div class="lesson-placeholder-icon">
                                        📚
                                    </div>

                                    Hãy chọn một bài học để xem nội dung.

                                </div>

                            </div>

                            <!-- =================================================
                                 THÔNG TIN BÀI TẬP
                            ================================================= -->

                            <div id="lesson-assignment-info"
                                 style="display:none;">

                                <div class="alert alert-info mt-3 mb-0">

                                    <div class="fw-bold mb-2">
                                        <i class="bi bi-pencil-square"></i>
                                        Thông tin bài tập
                                    </div>

                                    <div class="row">

                                        <div class="col-md-6">

                                            <strong>Hạn nộp:</strong>

                                            <span id="lesson-assignment-due">
                                            </span>

                                        </div>

                                        <div class="col-md-6">

                                            <strong>Điểm tối đa:</strong>

                                            <span id="lesson-assignment-score">
                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>
                            <!-- =================================================
                                 FILE ĐÍNH KÈM
                            ================================================= -->

                            <div id="lesson-view-attachment"
                                 style="display:none;">

                                <div class="lesson-attachment-box">

                                    <div class="lesson-attachment-title">

                                        <i class="bi bi-paperclip"></i>

                                        Tài liệu đính kèm

                                    </div>


                                    <a id="lesson-view-attachment-link"
                                       href="#"
                                       target="_blank"
                                       class="lesson-attachment-link">

                                        <i class="bi bi-file-earmark-arrow-down"></i>

                                        <span id="lesson-view-attachment-name">
                                        </span>

                                    </a>

                                </div>

                            </div>

                        </div>

                        <!-- =================================================
                             DỮ LIỆU ẨN CỦA TỪNG BÀI
                        ================================================= -->
                        @foreach (var lesson in lessons)
                        {
                            <div id="lesson-data-@lesson.Id"
                                 data-title="@lesson.Title"
                                 data-order="@lesson.OrderNumber"
                                 data-lesson-type="@(lesson.LessonType ?? "")"
                                 data-attachment-name="@(lesson.AttachmentFileName ?? "")"
                                 data-attachment-path="@(lesson.AttachmentPath ?? "")"
                                 data-due-date="@(lesson.Assignment?.DueDate?.ToString("o") ?? "")"
                                 data-max-score="@(lesson.Assignment?.MaxScore.ToString("0.##") ?? "")"
                                 style="display:none;">

                                <!-- =================================================
                                     NỘI DUNG BÀI
                                ================================================== -->
                                @if (!string.IsNullOrWhiteSpace(lesson.Content))
                                {
                                    @Html.Raw(lesson.Content)
                                }
                                else if (lesson.Quiz == null)
                                {
                                    <p class="text-muted">
                                        Chưa có nội dung cho bài học này.
                                    </p>
                                }


                                <!-- =================================================
                                     QUIZ
                                ================================================== -->
                                @if (lesson.Quiz != null)
                                {
                                    <div class="quiz-inline-box mt-4">

                                        <!-- =================================================
                                             THÔNG TIN QUIZ
                                        ================================================== -->

                                        <div class="quiz-inline-header">

                                            <div class="fw-bold fs-5">
                                                <i class="bi bi-question-circle"></i>
                                                @lesson.Quiz.Title
                                            </div>

                                            <div class="text-muted mt-2">

                                                <span class="me-3">
                                                    <i class="bi bi-clock"></i>
                                                    Thời gian:
                                                    @(lesson.Quiz.TimeLimitMinutes ?? 0) phút
                                                </span>

                                                <span>
                                                    <i class="bi bi-star"></i>
                                                    Điểm tối đa:
                                                    @lesson.Quiz.MaxScore
                                                </span>

                                            </div>

                                        </div>


                                        <!-- =================================================
                                             GIẢNG VIÊN
                                        ================================================== -->
                                        @if (isCourseTeacher)
                                        {
                                            <div class="quiz-question-list mt-4">

                                                @if (lesson.Quiz.Questions != null &&
                                               lesson.Quiz.Questions.Any())
                                                {
                                                    foreach (var question in lesson.Quiz.Questions
                                                    .OrderBy(q => q.OrderNumber)
                                                    .ThenBy(q => q.Id))
                                                    {
                                                        <div class="quiz-question-card">

                                                            <div class="d-flex justify-content-between">

                                                                <strong>
                                                                    Câu @question.OrderNumber
                                                                </strong>

                                                                <span>
                                                                    @question.Score điểm
                                                                </span>

                                                            </div>


                                                            <div class="mt-2">
                                                                @question.QuestionText
                                                            </div>


                                                            <div class="mt-3">

                                                                @{
                                                                    var letters =
                                                                    new[] { "A", "B", "C", "D" };

                                                                    var index = 0;
                                                                }

                                                                @foreach (var option in question.Options
                                                               .OrderBy(o => o.Id))
                                                                {
                                                                    <div class="quiz-option-row">

                                                                        <span class="quiz-option-letter">
                                                                            @(index < letters.Length
                                                                                ? letters[index]
                                                                                : (index + 1).ToString())
                                                                        </span>

                                                                        <span class="flex-grow-1">
                                                                            @option.OptionText
                                                                        </span>

                                                                        @if (option.IsCorrect)
                                                                        {
                                                                            <span class="badge bg-success ms-auto">
                                                                                Đúng
                                                                            </span>
                                                                        }

                                                                    </div>

                                                                    index++;
                                                                }

                                                            </div>


                                                            <!-- XÓA CÂU HỎI -->

                                                            <form asp-controller="Lesson"
                                                                  asp-action="DeleteQuizQuestion"
                                                                  method="post"
                                                                  class="mt-3"
                                                                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa câu hỏi này không?');">

                                                                @Html.AntiForgeryToken()

                                                                <input type="hidden"
                                                                       name="id"
                                                                       value="@question.Id" />

                                                                <button type="submit"
                                                                        class="btn btn-sm btn-outline-danger">

                                                                    <i class="bi bi-trash"></i>
                                                                    Xóa câu hỏi

                                                                </button>

                                                            </form>

                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="alert alert-secondary">
                                                        <i class="bi bi-info-circle"></i>
                                                        Quiz chưa có câu hỏi.
                                                    </div>
                                                }

                                            </div>


                                            <!-- =================================================
                                                 THÊM CÂU HỎI
                                            ================================================== -->

                                            <div class="quiz-add-question mt-4">

                                                <div class="fw-bold mb-3">

                                                    <i class="bi bi-plus-circle"></i>
                                                    Thêm câu hỏi

                                                </div>


                                                <form asp-controller="Lesson"
                                                      asp-action="AddQuizQuestion"
                                                      method="post">

                                                    @Html.AntiForgeryToken()


                                                    <input type="hidden"
                                                           name="quizId"
                                                           value="@lesson.Quiz.Id" />


                                                    <!-- CÂU HỎI -->

                                                    <div class="mb-3">

                                                        <label class="form-label fw-bold">
                                                            Nội dung câu hỏi
                                                        </label>

                                                        <textarea name="questionText"
                                                                  class="form-control"
                                                                  rows="3"
                                                                  placeholder="Nhập nội dung câu hỏi..."
                                                                  required></textarea>

                                                    </div>


                                                    <!-- A -->

                                                    <div class="mb-3">

                                                        <label class="form-label fw-bold">
                                                            Đáp án A
                                                        </label>

                                                        <input type="text"
                                                               name="optionA"
                                                               class="form-control"
                                                               maxlength="500"
                                                               required />

                                                    </div>


                                                    <!-- B -->

                                                    <div class="mb-3">

                                                        <label class="form-label fw-bold">
                                                            Đáp án B
                                                        </label>

                                                        <input type="text"
                                                               name="optionB"
                                                               class="form-control"
                                                               maxlength="500"
                                                               required />

                                                    </div>


                                                    <!-- C -->

                                                    <div class="mb-3">

                                                        <label class="form-label fw-bold">
                                                            Đáp án C
                                                        </label>

                                                        <input type="text"
                                                               name="optionC"
                                                               class="form-control"
                                                               maxlength="500"
                                                               required />

                                                    </div>


                                                    <!-- D -->

                                                    <div class="mb-3">

                                                        <label class="form-label fw-bold">
                                                            Đáp án D
                                                        </label>

                                                        <input type="text"
                                                               name="optionD"
                                                               class="form-control"
                                                               maxlength="500"
                                                               required />

                                                    </div>


                                                    <!-- ĐÁP ÁN ĐÚNG -->

                                                    <div class="mb-3">

                                                        <label class="form-label fw-bold">
                                                            Đáp án đúng
                                                        </label>

                                                        <div class="d-flex gap-4">

                                                            <div class="form-check">

                                                                <input class="form-check-input"
                                                                       type="radio"
                                                                       name="correctOption"
                                                                       value="0"
                                                                       checked />

                                                                <label class="form-check-label">
                                                                    A
                                                                </label>

                                                            </div>


                                                            <div class="form-check">

                                                                <input class="form-check-input"
                                                                       type="radio"
                                                                       name="correctOption"
                                                                       value="1" />

                                                                <label class="form-check-label">
                                                                    B
                                                                </label>

                                                            </div>


                                                            <div class="form-check">

                                                                <input class="form-check-input"
                                                                       type="radio"
                                                                       name="correctOption"
                                                                       value="2" />

                                                                <label class="form-check-label">
                                                                    C
                                                                </label>

                                                            </div>


                                                            <div class="form-check">

                                                                <input class="form-check-input"
                                                                       type="radio"
                                                                       name="correctOption"
                                                                       value="3" />

                                                                <label class="form-check-label">
                                                                    D
                                                                </label>

