                                                                       id="removeSectionFile-@lessonSection.Id" />

                                                                <label class="form-check-label"
                                                                       for="removeSectionFile-@lessonSection.Id">

                                                                    Xóa file hiện tại

                                                                </label>

                                                            </div>

                                                        </div>
                                                    }


                                                    <div class="mb-3">

                                                        <label class="form-label fw-bold">
