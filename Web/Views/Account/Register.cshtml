@model Web.Models.RegisterViewModel

@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_Site.cshtml";
}

<div class="lms-register-page">

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                <div class="lms-register-card">

                    <!-- BÊN TRÁI -->
                    <div class="lms-register-left">

                        <div class="lms-logo">
                            LMS
                        </div>

                        <h1>
                            Tạo tài khoản<br />
                            sinh viên
                        </h1>

                        <p>
                            Đăng ký tài khoản để tham gia khóa học,
                            theo dõi quá trình học tập và sử dụng
                            Trợ lý AI hỗ trợ học tập.
                        </p>

                        <div class="lms-feature">

                            <div class="lms-feature-item">
                                <div class="feature-number">01</div>
                                <div>
                                    <strong>Khóa học</strong>
                                    <small>Truy cập các khóa học</small>
                                </div>
                            </div>

                            <div class="lms-feature-item">
                                <div class="feature-number">02</div>
                                <div>
                                    <strong>Học tập</strong>
                                    <small>Theo dõi tiến độ học tập</small>
                                </div>
                            </div>

                            <div class="lms-feature-item">
                                <div class="feature-number">03</div>
                                <div>
                                    <strong>Trợ lý AI</strong>
                                    <small>Hỗ trợ giải đáp kiến thức</small>
                                </div>
                            </div>

                        </div>

                    </div>

                    <!-- BÊN PHẢI -->
                    <div class="lms-register-right">

                        <div class="register-title">
                            <h2>Đăng ký tài khoản</h2>
                            <p>Nhập thông tin để tạo tài khoản sinh viên</p>
                        </div>

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <form asp-action="Register"
                              asp-controller="Account"
                              method="post">

                            @Html.AntiForgeryToken()

                            <div class="row">

                                <!-- MSSV -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="MSSV">
                                        MSSV
                                    </label>

                                    <input asp-for="MSSV"
                                           class="form-control"
                                           placeholder="Nhập mã số sinh viên" />

                                    <span asp-validation-for="MSSV"
                                          class="text-danger">
                                    </span>
                                </div>

                                <!-- HỌ TÊN -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="FullName">
                                        Họ và tên
                                    </label>

                                    <input asp-for="FullName"
                                           class="form-control"
                                           placeholder="Nhập họ và tên" />

                                    <span asp-validation-for="FullName"
                                          class="text-danger">
                                    </span>
                                </div>

                                <!-- EMAIL -->
                                <div class="col-12 mb-3">
                                    <label asp-for="Email">
                                        Email
                                    </label>

                                    <input asp-for="Email"
                                           class="form-control"
                                           placeholder="Nhập địa chỉ email" />

                                    <span asp-validation-for="Email"
                                          class="text-danger">
                                    </span>
                                </div>

                                <!-- USERNAME -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Username">
                                        Tên đăng nhập
                                    </label>

                                    <input asp-for="Username"
                                           class="form-control"
                                           placeholder="Nhập tên đăng nhập" />

                                    <span asp-validation-for="Username"
                                          class="text-danger">
                                    </span>
                                </div>

                                <!-- LỚP -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ClassName">
                                        Lớp
                                    </label>

                                    <input asp-for="ClassName"
                                           class="form-control"
                                           placeholder="Ví dụ: 22TH01" />

                                    <span asp-validation-for="ClassName"
                                          class="text-danger">
                                    </span>
                                </div>

                                <!-- MẬT KHẨU -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Password">
                                        Mật khẩu
                                    </label>

                                    <input asp-for="Password"
                                           class="form-control"
                                           placeholder="Nhập mật khẩu" />
                                    <span asp-validation-for="Password"
                                          class="text-danger">
                                    </span>
                                </div>

                                <!-- NHẬP LẠI MẬT KHẨU -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ConfirmPassword">
                                        Nhập lại mật khẩu
                                    </label>

                                    <input asp-for="ConfirmPassword"
                                           type="password"
                                           class="form-control"
                                           placeholder="Nhập lại mật khẩu" />

                                    <span asp-validation-for="ConfirmPassword"
                                          class="text-danger">
                                    </span>
                                </div>

                                <!-- BUTTON -->
                                <div class="col-12 mt-2">
                                    <button type="submit"
                                            class="btn lms-register-btn w-100">
                                        Đăng ký tài khoản
                                    </button>
                                </div>

                            </div>

                        </form>

                        <div class="register-login">
                            <span>Đã có tài khoản?</span>

                            <a asp-controller="Account"
                               asp-action="Login">
                                Đăng nhập ngay
                            </a>
                        </div>

                    </div>

                </div>

            </div>
        </div>
    </div>

</div>

@section Css {

    <style>

        .lms-register-page {
            background: #f3f6fa;
            min-height: calc(100vh - 150px);
        }

        .lms-register-card {
            display: flex;
            background: #ffffff;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        }

        .lms-register-left {
            width: 40%;
            padding: 50px 40px;
            background: linear-gradient(145deg, #1f2937, #27384d, #1e3a5f);
            color: #ffffff;
        }

        .lms-logo {
            width: 55px;
            height: 55px;
            background: #527da8;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 35px;
        }

        .lms-register-left h1 {
            font-size: 32px;
            font-weight: 700;
            line-height: 1.3;
            margin-bottom: 20px;
        }

        .lms-register-left p {
            color: #d7dee7;
            line-height: 1.7;
            margin-bottom: 35px;
        }

        .lms-feature-item {
            display: flex;
            align-items: center;
            margin-bottom: 22px;
        }

        .feature-number {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            font-size: 12px;
            font-weight: 600;
        }

        .lms-feature-item strong {
            display: block;
            font-size: 14px;
        }

        .lms-feature-item small {
            display: block;
            color: #cbd5df;
            margin-top: 3px;
        }

        .lms-register-right {
            width: 60%;
            padding: 45px 50px;
            background: #ffffff;
        }

        .register-title h2 {
            color: #263445;
            font-size: 29px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .register-title p {
            color: #7a8795;
            margin-bottom: 25px;
        }

        .lms-register-right label {
            display: block;
            color: #374151;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .lms-register-right .form-control {
            height: 46px;
            border: 1px solid #d8dee6;
            border-radius: 8px;
            padding: 10px 14px;
            box-shadow: none;
        }

            .lms-register-right .form-control:focus {
                border-color: #527da8;
                box-shadow: 0 0 0 3px rgba(82, 125, 168, 0.12);
            }

        .lms-register-btn {
            height: 48px;
            border: none;
            border-radius: 8px;
            background: #343a40;
            color: #ffffff;
            font-size: 15px;
            font-weight: 600;
        }

            .lms-register-btn:hover {
                background: #212529;
                color: #ffffff;
            }

        .register-login {
            text-align: center;
            margin-top: 22px;
            color: #7a8795;
        }

            .register-login a {
                color: #527da8;
                font-weight: 600;
                text-decoration: none;
                margin-left: 5px;
            }

    </style>

}