@model dynamic

@{
    ViewData["Title"] = "Điểm trung bình theo khóa học";
    Layout = "~/Areas/Admin/Views/Shared/_Admin.cshtml";
}

<div class="container-fluid px-4 mt-4">
    <div class="card mb-4 shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-chart-bar me-1"></i> Báo Cáo Điểm Trung Bình Theo Khóa Học</h5>
            <span class="badge bg-success">Dữ liệu thời gian thực</span>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 8%">STT</th>
                            <th>Khóa học</th>
                            <th style="width: 20%" class="text-center">Số sinh viên có điểm</th>
                            <th style="width: 15%" class="text-center">Điểm trung bình</th>
                            <th style="width: 20%" class="text-center">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int stt = 1;
                        }
                        @if (Model == null || !((System.Collections.ICollection)Model).Cast<object>().Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Chưa có dữ liệu điểm nào.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@stt</td>
                                    <td class="font-weight-bold text-secondary">@item.TenKhoa</td>
                                    <td class="text-center font-weight-bold text-dark">
                                        @item.SoLuongSinhVien
                                    </td>
                                    <td class="text-center font-weight-bold text-danger">
                                        @item.DiemTrungBinh
                                    </td>
                                    <td class="text-center">
                                        @if (item.DiemTrungBinh >= 7)
                                        {
                                            <span class="badge bg-success">✅ Tốt</span>
                                        }
                                        else if (item.DiemTrungBinh < 5)
                                        {
                                            <span class="badge bg-danger">⚠️ Cần cải thiện</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Trung bình</span>
                                        }
                                    </td>
                                </tr>
                                stt++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
